# OpenMAIC settings the estate always sets. Merged after .env by compose, so a
# value here wins for the classroom container only.

# The classroom is reachable only through the bridge/console flow and its own
# origins; it is not a public single-user installation.
OWNER_SINGLE_USER=false

# AthenIQ identity: the bridge's classroom token is the owner identity. Both
# values are read by the OpenMAIC patch (applied by scripts/bootstrap.sh).
ATHENIQ_BRIDGE_JWT_SECRET=${BRIDGE_JWT_SECRET}
ATHENIQ_BRIDGE_URL=http://bridge:8787
ATHENIQ_BRIDGE_HOOK_SECRET=${BRIDGE_HOOK_SECRET}

# Long-running generation happens inside the server; the console redirects here
# and the run continues even if the learner closes the tab.
NODE_OPTIONS=--max-old-space-size=2048
