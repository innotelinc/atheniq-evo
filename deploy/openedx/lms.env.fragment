# Open edX settings the AthenIQ estate adds.
#
# The patch series does not modify Open edX source: the LMS already exposes the
# two endpoints the bridge needs (completion-batch and the gradebook bulk
# update), and its own authentication covers them. What it needs is to know the
# estate's hosts, and to keep the gradebook write API available.

# --- hosts ------------------------------------------------------------------
SITE_NAME: ${ATHENIQ_PUBLIC_HOST:-atheniq.institute}
LMS_BASE: ${LMS_PUBLIC_URL:-http://localhost:18000}
CMS_BASE: ${CMS_PUBLIC_URL:-http://localhost:18010}

# The console is the academic record and the classroom is the instruction
# surface; both are trusted origins for CORS and for course about links.
CORS_ORIGIN_WHITELIST:
  - ${CONSOLE_ORIGIN:-http://localhost:3100}
  - ${CLASSROOM_PUBLIC_URL:-http://localhost:3000}

LOGIN_REDIRECT_WHITELIST:
  - ${CONSOLE_ORIGIN:-http://localhost:3100}
  - ${CLASSROOM_PUBLIC_URL:-http://localhost:3000}

# --- the bridge's two writes -------------------------------------------------
# Completion writes are per-learner and need no course-author role; the grade
# override does, and is gated per course by the writable-gradebook flag. The
# bridge's service user is created by deploy/openedx/provision-bridge.sh.
FEATURES:
  WRITABLE_GRADEBOOK: true

# Completion is stored for every block the bridge marks; without this the
# completion API records progress but the progress page ignores it.
ENABLE_COMPLETION_TRACKING: true

# --- identity ---------------------------------------------------------------
# Learners keep their Open edX accounts; the bridge addresses them by username.
# Course-author access for the service user is granted per course in Studio.
OAUTH2_PROVIDER:
  SCOPES:
    - read
    - write
    - profile
