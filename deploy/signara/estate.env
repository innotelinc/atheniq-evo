# Signara — estate settings for AthenIQ.
#
# Copy to the Signara checkout as `.env`, resolve every __SET_FROM_VAULT__ below
# from Cerulean Vault, then `chmod 600 .env` and run `./setup.sh --production`.
#
# Signara has no runtime resolver for `vault://` references: such a value is
# passed to the container as a literal string. Read each secret out at deploy
# time instead (scripts/vault-migrate.py is the plaintext -> Vault direction,
# not the other way round):
#
#   vault kv get -field=POSTGRES_PASSWORD cerulean/signara
#
# Never commit the filled-in file.

NODE_ENV=production
APP_NAME=Signara
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------ URLs ---
# The web app compiles API_URL in at build time, so both must be final.
APP_URL=https://app.signara.innotel.us
WEB_URL=https://app.signara.innotel.us
API_URL=https://api.signara.innotel.us
AUTH_URL=https://auth.cerulean.innotel.us

# Loopback only; the estate edge (Cerulean / NPM) terminates TLS for app./api.
WEB_BIND_ADDRESS=127.0.0.1
WEB_BIND_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_BIND_PORT=8000

# ------------------------------------------------------------------ OIDC ---
# The estate already runs Authentik; do not start Signara's local copy.
AUTHENTIK_MODE=remote
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/signara/
OIDC_AUTHORIZATION_URL=https://auth.cerulean.innotel.us/application/o/authorize/
OIDC_TOKEN_URL=https://auth.cerulean.innotel.us/application/o/token/
OIDC_USERINFO_URL=https://auth.cerulean.innotel.us/application/o/userinfo/
OIDC_JWKS_URL=https://auth.cerulean.innotel.us/application/o/signara/jwks/
OIDC_REDIRECT_URI=https://api.signara.innotel.us/api/v1/auth/callback
OIDC_CLIENT_ID=signara-web
OIDC_CLIENT_SECRET=__SET_FROM_VAULT__OIDC_CLIENT_SECRET
OIDC_SCOPES="openid profile email groups"
IDP_ADMIN_GROUP=signara-admins

CORS_ORIGINS=https://app.signara.innotel.us
CSP_REPORT_URI=https://api.signara.innotel.us/api/v1/audit/csp-report

# ------------------------------------------------------------ datastores ---
# Leave DATABASE_URL/REDIS_URL blank: setup.sh writes them from the parts.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=signara
POSTGRES_DB=signara
POSTGRES_PASSWORD=__SET_FROM_VAULT__POSTGRES_PASSWORD
DATABASE_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__SET_FROM_VAULT__REDIS_PASSWORD
REDIS_URL=

# Documents live in the estate's ONYX store, not a local MinIO.
SIGNARA_S3_ENDPOINT=http://192.168.1.71:2090
SIGNARA_S3_REGION=us-east-1
SIGNARA_S3_BUCKET=signara-documents
SIGNARA_S3_FORCE_PATH_STYLE=true
SIGNARA_S3_PUBLIC_ENDPOINT=https://storage.signara.innotel.us
SIGNARA_S3_ACCESS_KEY=__SET_FROM_VAULT__S3_ACCESS_KEY
SIGNARA_S3_SECRET_KEY=__SET_FROM_VAULT__S3_SECRET_KEY

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=__SET_FROM_VAULT__MEILISEARCH_API_KEY

# ----------------------------------------------------------------- tokens ---
JWT_ACCESS_SECRET=__SET_FROM_VAULT__JWT_ACCESS_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=__SET_FROM_VAULT__JWT_REFRESH_SECRET
JWT_REFRESH_TTL=30d
CRYPTO_MASTER_KEY=__SET_FROM_VAULT__CRYPTO_MASTER_KEY

# --------------------------------------------------------------- Cerulean ---
# Only needed for `setup.sh --with-cerulean` (DNS records via Cerulean).
# CERULEAN_DNS_API_URL=http://192.168.1.71:3003
# CERULEAN_SERVICE_KEY=__SET_FROM_VAULT__
# CERULEAN_ZONE=signara.innotel.us
# CERULEAN_BASE_DOMAIN=signara.innotel.us
# CERULEAN_ADMIN_PASSWORD=__SET_FROM_VAULT__
