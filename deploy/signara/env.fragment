# Signara settings the estate always sets.
#
# Signara owns its own database, object storage and OIDC provider; those come
# from its deployment (upstream docker-compose.prod.yml) and are not invented
# here. What the integration needs is that the console can reach the API with a
# key that holds the document and signature scopes.

# The public origin the API advertises in OpenAPI and callbacks.
API_PUBLIC_URL=${SIGNARA_API_URL:-https://api.signara.innotel.us}

# Award documents are uploaded by the console, so the API must accept requests
# from the console's host.
CORS_ORIGINS=${CONSOLE_ORIGIN:-http://localhost:3100}

# Never derive this from a request Host header.
TRUST_PROXY=false
