# Template for the gitignored Coolify deploy file. Do not copy this by hand:
#
#   node scripts/coolify-deploy.mjs --init
#
# writes `.env.coolify` (gitignored by `.env.*`) with the two secrets below
# generated and the token left empty for you to paste. `--init` refuses to
# overwrite an existing file, because new secrets invalidate live sessions.
#
# The token: Coolify UI -> Keys & Tokens -> API tokens -> Create New Token,
# name `atheniq-deploy`, permission `write` (the default `read` cannot deploy).
# It is shown once. Paste it into COOLIFY_TOKEN in `.env.coolify`.
#
# COOLIFY_BASE_URL is the Coolify instance itself, no /api/v1, and NOT the edge
# name: `deploy.innotel.us` reaches the same panel through the edge, where
# Authentik's outpost answers first and redirects a bearer token to a login page.
# The edge's own NPM row forwards that name to http://192.168.1.85:8000, so that
# is the address to use — the outpost is not in the path at all.
#
# Nothing here is committed and nothing is printed by the tooling: values are
# read from `.env.coolify` and sent only to that base URL.

COOLIFY_BASE_URL=http://192.168.1.85:8000
COOLIFY_TOKEN=

# Where the resource lands. The project is created if it does not exist.
COOLIFY_PROJECT=atheniq
# The Coolify server record to deploy on, by name. `i3-local` is documented as the
# institution's intended destination, but i3's Docker 29 buildkit session dies at
# `exporting layers` (deploy/signara/README.md), so `i2-local` builds instead.
COOLIFY_SERVER=i2-local

# The Git remote Coolify reads, and the branch it deploys.
COOLIFY_GIT_REPOSITORY=https://github.com/innotelinc/atheniq-evo.git
COOLIFY_GIT_BRANCH=main
COOLIFY_COMPOSE_LOCATION=/docker-compose.coolify.yml

# innotelinc/atheniq-evo is PRIVATE, so the public-repository endpoint cannot
# clone it: name the GitHub App installed for innotelinc (Coolify -> Sources),
# or a private key already added there. With neither, the script uses
# /applications/public and the clone fails on the private repository.
COOLIFY_GITHUB_APP_UUID=
COOLIFY_PRIVATE_KEY_UUID=

# The two hostnames, both on the institution container's port 8080.
INSTITUTION_ORIGIN=https://atheniq.innotel.site
REGISTRAR_ORIGIN=https://registrar.innotel.site

# Generated by --init. Do not hand-edit to something short.
SESSION_SECRET=
REGISTRAR_EMAIL=registrar@atheniq.institute
REGISTRAR_PASSWORD=

# `local` reserves addresses without creating mailboxes, so the site comes up
# without a Stalwart key. Switch to `stalwart` and add STALWART_URL plus
# STALWART_TOKEN when the mailbox provisioning is wanted.
MAIL_PROVIDER=local
MAIL_DOMAIN=atheniq.institute
