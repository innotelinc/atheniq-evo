# Template for the Coolify API token file. Copy to the repository root as
# `.env.coolify` (that name is gitignored) and fill in the two values below.
#
#   cd <repository root>
#   cp deploy/coolify/.env.coolify.example .env.coolify
#   # then edit .env.coolify: COOLIFY_BASE_URL and COOLIFY_TOKEN
#   git check-ignore -v .env.coolify    # must print the .gitignore rule
#
# Create the token in Coolify: Keys & Tokens -> API tokens -> Create New Token,
# name it `atheniq-deploy`, permission `write` (deploying needs more than the
# read-only default), and copy the value once — the UI never shows it again.
#
# COOLIFY_BASE_URL is the Coolify instance itself, without /api/v1:
#   https://coolify.example.org          (a hosted name, TLS terminated)
#   http://192.168.1.52:8000             (the default self-hosted port)
#
# Nothing here is committed and nothing is printed by the tooling: values are
# read from this file and sent only to that base URL.

COOLIFY_BASE_URL=
COOLIFY_TOKEN=

# Where the resource lands. The project is created if it does not exist.
COOLIFY_PROJECT=atheniq
# The server to deploy on. Leave empty when the instance has one server.
COOLIFY_SERVER_UUID=

# The Git remote Coolify reads, and the branch it deploys.
COOLIFY_GIT_REPOSITORY=https://github.com/innotelinc/atheniq-evo.git
COOLIFY_GIT_BRANCH=main
COOLIFY_COMPOSE_LOCATION=/docker-compose.coolify.yml
