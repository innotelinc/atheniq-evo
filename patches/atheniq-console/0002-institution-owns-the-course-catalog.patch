 const PUBLIC_SITE = /^\/site(\/|$)/;
 
+/**
+ * Where course authoring lives. This app keeps awards, degree plans and the
+ * internal routes the bridge calls; the catalog has one owner — the institution
+ * console at the registrar host — and these pages point there instead of
+ * offering a second place to add, edit, generate or remove a course.
+ */
+const CATALOG_OWNER = (process.env.INSTITUTION_CONSOLE_URL || "https://registrar.atheniq.institute").replace(/\/+$/, "");
+const CATALOG_PATHS = [/^\/courses(\/|$)/, /^\/generate(\/|$)/];
+/** The institution's own children of /courses, spelled the same way there. */
+const CATALOG_CHILDREN = /^\/courses\/(new|generate|sync|import)\/?$/;
+
+/**
+ * Where a catalog path ends up on the institution console. The two apps do not
+ * spell every page alike: the generator is `/courses/generate` over there, and a
+ * course record is addressed by its code rather than by this app's id — so an old
+ * `/courses/<id>` lands on the institution's catalog instead of on a 404.
+ */
+function catalogTarget(pathname: string): string | null {
+  if (!CATALOG_PATHS.some((pattern) => pattern.test(pathname))) return null;
+  if (pathname === "/generate" || pathname === "/generate/") return "/courses/generate";
+  if (pathname.startsWith("/generate/")) return "/courses";
+  if (CATALOG_CHILDREN.test(pathname)) return pathname.replace(/\/+$/, "");
+  return "/courses";
+}
+
