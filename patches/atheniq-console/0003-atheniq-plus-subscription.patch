--- /dev/null
+++ b/mobile/lib/purchases.ts
@@ -0,0 +1,76 @@
+import { Platform } from "react-native";
+import Purchases, { LOG_LEVEL, type PurchasesPackage } from "react-native-purchases";
+
+/**
+ * The store, in one place.
+ *
+ * RevenueCat wraps StoreKit and Play Billing, so the app asks for a package and
+ * hands the result to the server to record. The public SDK key is baked in at
+ * build time; without it the paywall says subscriptions are not available in
+ * this build rather than failing at random. Expo Go runs RevenueCat in preview
+ * mode — the code loads, but real purchases need a development or store build.
+ */
+const IOS_KEY = (process.env.EXPO_PUBLIC_REVENUECAT_IOS_KEY || "").trim();
+const ANDROID_KEY = (process.env.EXPO_PUBLIC_REVENUECAT_ANDROID_KEY || "").trim();
+
+const apiKey = Platform.OS === "ios" ? IOS_KEY : Platform.OS === "android" ? ANDROID_KEY : "";
+export const purchasesConfigured = Boolean(apiKey);
+
+let configuredFor: string | null = null;
+
+/** Configure once per learner id: the id is how the server finds the receipt. */
+export function configurePurchases(learnerId: string): boolean {
+  if (!apiKey) return false;
+  if (configuredFor === learnerId) return true;
+  Purchases.configure({ apiKey, appUserID: learnerId });
+  if (typeof __DEV__ !== "undefined" && __DEV__) Purchases.setLogLevel(LOG_LEVEL.DEBUG);
+  configuredFor = learnerId;
+  return true;
+}
+
+export interface StorePackage {
+  identifier: string;
+  productId: string;
+  priceString: string;
+  title: string;
+}
+
+export async function storePackages(): Promise<StorePackage[]> {
+  if (!apiKey) return [];
+  const offerings = await Purchases.getOfferings();
+  const packages = offerings.current?.availablePackages ?? [];
+  return packages.map((pkg: PurchasesPackage) => ({
+    identifier: pkg.identifier,
+    productId: pkg.product.identifier,
+    priceString: pkg.product.priceString,
+    title: pkg.product.title,
+  }));
+}
+
+function cancelled(error: unknown): boolean {
+  const value = error as { userCancelled?: boolean; code?: string } | null;
+  return Boolean(value?.userCancelled) || value?.code === "1";
+}
+
+export async function purchaseProduct(
+  productId: string,
+): Promise<{ purchased: boolean; cancelled: boolean }> {
+  if (!apiKey) throw new Error("Subscriptions are available in the App Store and Play Store builds.");
+  const offerings = await Purchases.getOfferings();
+  const pkg = (offerings.current?.availablePackages ?? []).find(
+    (item) => item.product.identifier === productId,
+  );
+  if (!pkg) throw new Error("That plan is not available in this store yet.");
+  try {
+    await Purchases.purchasePackage(pkg);
+    return { purchased: true, cancelled: false };
+  } catch (error) {
+    if (cancelled(error)) return { purchased: false, cancelled: true };
+    throw error;
+  }
+}
+
+export async function restorePurchases(): Promise<void> {
+  if (!apiKey) throw new Error("Subscriptions are available in the App Store and Play Store builds.");
+  await Purchases.restorePurchases();
+}
