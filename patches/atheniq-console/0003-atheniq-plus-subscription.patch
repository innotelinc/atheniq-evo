+import { useCallback, useState } from "react";
+import { KeyboardAvoidingView, Platform, ScrollView, StyleSheet, Text, TextInput, View } from "react-native";
+import { useLocalSearchParams, useRouter } from "expo-router";
+import { Body, Button, Card, Chip, ErrorNote, Muted, Screen } from "@/components/ui";
+import { ApiError, api, errorMessage, type CoachReply } from "@/lib/api";
+import { usePremium } from "@/lib/premium";
+import { useSession } from "@/lib/session";
+import { colors, radius, space, type } from "@/lib/theme";
+
+export default function CoachScreen() {
+  const router = useRouter();
+  const { courseId } = useLocalSearchParams<{ courseId?: string }>();
+  const { learner } = useSession();
+  const { isPlus } = usePremium();
+  const [question, setQuestion] = useState("");
+  const [reply, setReply] = useState<CoachReply | null>(null);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  const ask = useCallback(async () => {
+    if (!learner || question.trim().length < 4) return;
+    setBusy(true);
+    setError("");
+    try {
+      setReply(await api.coach(learner.token, { question: question.trim(), courseId: courseId || undefined }));
+    } catch (caught) {
+      if (caught instanceof ApiError && caught.status === 402) {
+        setError("The study coach is part of AthenIQ Plus.");
+      } else {
+        setError(errorMessage(caught));
+      }
+    } finally {
+      setBusy(false);
+    }
+  }, [learner, question, courseId]);
+
+  if (!learner) {
+    return (
+      <Screen>
+        <ScrollView contentContainerStyle={styles.content}>
+          <Text style={styles.eyebrow}>STUDY COACH</Text>
+          <Text style={styles.title}>Ask about the lesson in front of you</Text>
+          <Body>Sign in to keep the coach tied to your courses and your progress.</Body>
+          <Button label="Sign in" onPress={() => router.push("/sign-in")} />
+        </ScrollView>
+      </Screen>
+    );
+  }
+
+  if (!isPlus) {
+    return (
+      <Screen>
+        <ScrollView contentContainerStyle={styles.content}>
+          <Text style={styles.eyebrow}>STUDY COACH</Text>
+          <Text style={styles.title}>A coach that has read the course</Text>
+          <Card style={{ gap: space(2) }}>
+            <Body>
+              The coach answers from the course record: its outcomes, its modules and the lesson you
+              are on. It will not invent a grade or a deadline — those are the registrar's.
+            </Body>
+            <Chip label="AthenIQ Plus" tone="brand" />
+          </Card>
+          <Button label="See AthenIQ Plus" onPress={() => router.push("/premium")} />
+          <Button label="Back" variant="quiet" onPress={() => router.back()} />
+        </ScrollView>
+      </Screen>
+    );
+  }
+
+  return (
+    <Screen>
+      <KeyboardAvoidingView
+        style={{ flex: 1 }}
+        behavior={Platform.OS === "ios" ? "padding" : undefined}
+        keyboardVerticalOffset={24}
+      >
+        <ScrollView contentContainerStyle={styles.content} keyboardShouldPersistTaps="handled">
+          <Text style={styles.eyebrow}>STUDY COACH</Text>
+          <Text style={styles.title}>What are you stuck on?</Text>
+          <Muted>{courseId ? "Answers use this course's record." : "Open a course first for answers grounded in it."}</Muted>
+
+          {error ? <ErrorNote message={error} /> : null}
+
+          {reply ? (
+            <Card style={{ gap: space(2) }}>
+              <Chip label={reply.source === "model" ? "Coach" : "Course-based plan"} tone="brand" />
+              <Body>{reply.answer}</Body>
+            </Card>
+          ) : null}
+
+          <TextInput
+            value={question}
+            onChangeText={setQuestion}
+            placeholder="e.g. I do not understand why gradient descent needs a learning rate"
+            placeholderTextColor={colors.faint}
+            multiline
+            style={styles.input}
+          />
+          <Button
+            label="Ask the coach"
+            onPress={ask}
+            loading={busy}
+            disabled={question.trim().length < 4}
+          />
+          <Button label="Back" variant="quiet" onPress={() => router.back()} />
+        </ScrollView>
+      </KeyboardAvoidingView>
+    </Screen>
+  );
+}
+
+const styles = StyleSheet.create({
+  content: { padding: space(5), paddingBottom: space(16), gap: space(3.5) },
+  eyebrow: { ...type.tiny, color: colors.brand, fontWeight: "700", letterSpacing: 1.4 },
+  title: { ...type.display, fontSize: 27, lineHeight: 32, color: colors.ink },
+  input: {
+    minHeight: 120,
+    textAlignVertical: "top",
+    borderRadius: radius.md,
+    borderWidth: 1,
+    borderColor: colors.lineStrong,
+    backgroundColor: colors.surface,
+    color: colors.ink,
+    padding: space(3),
+    ...type.body,
+  },
+});
