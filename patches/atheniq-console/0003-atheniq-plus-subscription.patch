diff --git a/app/api/internal/revenuecat/webhook/route.ts b/app/api/internal/revenuecat/webhook/route.ts
new file mode 100644
index 0000000..9766744
--- /dev/null
+++ b/app/api/internal/revenuecat/webhook/route.ts
@@ -0,0 +1,61 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import { NextResponse } from "next/server";
+import { getDb, mutate } from "@/lib/store";
+import { upsertMembership } from "@/lib/premium";
+import { membershipFromEvent, type RevenueCatEvent } from "@/lib/revenuecat";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * RevenueCat's server-to-server events.
+ *
+ * A renewal that happens while nobody opens the app still has to extend the
+ * membership, and a refund has to end it. Both arrive here. The endpoint is
+ * disabled until REVENUECAT_WEBHOOK_TOKEN is set, and the token is compared in
+ * constant time because it is the only thing standing between the internet and
+ * a write to a learner's account.
+ */
+function authorised(request: Request): boolean {
+  const expected = (process.env.REVENUECAT_WEBHOOK_TOKEN || "").trim();
+  if (!expected) return false;
+  const header = request.headers.get("authorization") || "";
+  const given = header.startsWith("Bearer ") ? header.slice(7) : "";
+  const a = createHash("sha256").update(given).digest();
+  const b = createHash("sha256").update(expected).digest();
+  return timingSafeEqual(a, b);
+}
+
+export async function POST(request: Request) {
+  if (!(process.env.REVENUECAT_WEBHOOK_TOKEN || "").trim()) {
+    return NextResponse.json({ ok: false, error: "Webhook is not configured." }, { status: 503 });
+  }
+  if (!authorised(request)) {
+    return NextResponse.json({ ok: false, error: "Unauthorized." }, { status: 401 });
+  }
+
+  let body: { event?: RevenueCatEvent };
+  try {
+    body = (await request.json()) as { event?: RevenueCatEvent };
+  } catch {
+    return NextResponse.json({ ok: false, error: "Invalid JSON." }, { status: 400 });
+  }
+
+  const event = body.event;
+  if (!event?.app_user_id) {
+    return NextResponse.json({ ok: false, error: "Event has no app user id." }, { status: 400 });
+  }
+
+  const db = getDb();
+  const learner = db.learners.find(
+    (item) =>
+      item.id === event.app_user_id ||
+      item.email.toLowerCase() === String(event.app_user_id).toLowerCase(),
+  );
+  if (!learner) return NextResponse.json({ ok: true, ignored: true });
+
+  const membership = membershipFromEvent(event, learner.id);
+  if (!membership) return NextResponse.json({ ok: true, ignored: true });
+
+  await mutate((database) => upsertMembership(database, membership));
+  return NextResponse.json({ ok: true, stored: true, learnerId: learner.id, status: membership.status });
+}
diff --git a/app/api/mobile/v1/analytics/route.ts b/app/api/mobile/v1/analytics/route.ts
new file mode 100644
index 0000000..7ced63c
--- /dev/null
+++ b/app/api/mobile/v1/analytics/route.ts
@@ -0,0 +1,117 @@
+import { getDb } from "@/lib/store";
+import { fail, ok, preflight } from "@/lib/mobile-api";
+import { bearerIdentity } from "@/lib/mobile-auth";
+import { isPlus } from "@/lib/premium";
+
+export const dynamic = "force-dynamic";
+
+const WEEK_MS = 7 * 24 * 60 * 60 * 1000;
+
+/**
+ * Study analytics — a Plus feature.
+ *
+ * Everything here is derived from enrollments and the catalog, so it is true
+ * for a learner who has never opened the app on the web. Pace is lessons per
+ * week since enrollment, not a guess about effort; "focus" is the modules with
+ * the least completion, which is the one thing a list of percentages does not
+ * say by itself.
+ */
+export async function GET(request: Request) {
+  const identity = bearerIdentity(request);
+  if (!identity) return fail("Sign in.", 401);
+  if (identity.role !== "learner") return fail("Analytics belong to learner accounts.", 403);
+
+  const db = getDb();
+  const learner = db.learners.find((item) => item.id === identity.sub);
+  if (!learner) return fail("That learner account no longer exists.", 401);
+  if (!isPlus(db, learner.id)) {
+    return fail("AthenIQ Plus unlocks study analytics.", 402, { upgrade: "plus" });
+  }
+
+  const now = new Date();
+  const enrollments = db.enrollments.filter((item) => item.learnerId === learner.id);
+
+  let lessonsDone = 0;
+  let minutesRemaining = 0;
+  let credits = 0;
+  let lastStudiedAt: string | null = null;
+  const focus: { courseId: string; course: string; module: string; percent: number }[] = [];
+
+  const courses = enrollments
+    .map((enrollment) => {
+      const course = db.courses.find((item) => item.id === enrollment.courseId);
+      if (!course) return null;
+      const doneIds = new Set(enrollment.completedLessonIds);
+      const lessons = course.modules.flatMap((module) => module.lessons);
+      const done = lessons.filter((lesson) => doneIds.has(lesson.id)).length;
+      const total = lessons.length;
+      const percent = total ? Math.round((done / total) * 100) : 0;
+      const weeks = Math.max(1, (now.getTime() - Date.parse(enrollment.enrolledAt)) / WEEK_MS);
+      const pacePerWeek = Math.round((done / weeks) * 10) / 10;
+      const remaining = lessons
+        .filter((lesson) => !doneIds.has(lesson.id))
+        .reduce((sum, lesson) => sum + lesson.minutes, 0);
+
+      lessonsDone += done;
+      minutesRemaining += remaining;
+      if (enrollment.completedAt) credits += course.credits;
+      if (!lastStudiedAt || enrollment.lastSeenAt > lastStudiedAt) lastStudiedAt = enrollment.lastSeenAt;
+
+      for (const module of course.modules) {
+        const moduleDone = module.lessons.filter((lesson) => doneIds.has(lesson.id)).length;
+        const modulePercent = module.lessons.length
+          ? Math.round((moduleDone / module.lessons.length) * 100)
+          : 0;
+        if (modulePercent < 100 && !enrollment.completedAt) {
+          focus.push({ courseId: course.id, course: course.title, module: module.title, percent: modulePercent });
+        }
+      }
+
+      return {
+        id: course.id,
+        code: course.code,
+        title: course.title,
+        percent,
+        done,
+        total,
+        credits: course.credits,
+        completedAt: enrollment.completedAt,
+        enrolledAt: enrollment.enrolledAt,
+        pacePerWeek,
+        remainingMinutes: remaining,
+        lastSeenAt: enrollment.lastSeenAt,
+      };
+    })
+    .filter((item): item is NonNullable<typeof item> => Boolean(item))
+    .sort((a, b) => b.lastSeenAt.localeCompare(a.lastSeenAt));
+
+  focus.sort((a, b) => a.percent - b.percent);
+  const daysSinceLastStudy = lastStudiedAt
+    ? Math.max(0, Math.floor((now.getTime() - Date.parse(lastStudiedAt)) / (24 * 60 * 60 * 1000)))
+    : null;
+
+  return ok({
+    generatedAt: now.toISOString(),
+    totals: {
+      enrolled: courses.length,
+      active: courses.filter((item) => !item.completedAt).length,
+      completed: courses.filter((item) => item.completedAt).length,
+      credits,
+      lessonsDone,
+      minutesRemaining,
+      daysSinceLastStudy,
+    },
+    courses: courses.slice(0, 8),
+    focus: focus.slice(0, 3),
+    note:
+      daysSinceLastStudy === null
+        ? "Start reading and this page fills in."
+        : daysSinceLastStudy > 7
+          ? "It has been a while. One lesson restarts the habit."
+          : null,
+  });
+}
+
+export function OPTIONS() {
+  return preflight();
+}
diff --git a/app/api/mobile/v1/coach/route.ts b/app/api/mobile/v1/coach/route.ts
new file mode 100644
index 0000000..3c6e38c
--- /dev/null
+++ b/app/api/mobile/v1/coach/route.ts
@@ -0,0 +1,122 @@
+import { getDb } from "@/lib/store";
+import { fail, ok, preflight, text } from "@/lib/mobile-api";
+import { bearerIdentity } from "@/lib/mobile-auth";
+import { isPlus } from "@/lib/premium";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * The AI study coach — a Plus feature.
+ *
+ * It answers about the course in front of the learner, with the course's own
+ * outcomes and module list as context, and refuses to invent grades, deadlines
+ * or policy: those belong to the registrar. Without a configured gateway it
+ * answers from a deterministic study plan, so a deployment with no model key
+ * still gives the learner something true rather than an error.
+ */
+const SYSTEM = `You are the study coach for AthenIQ Institute, an online university.
+Answer in at most 150 words of plain prose, with no markdown headings and no lists
+longer than four items. Use only the course context in the user's message. If the
+question is not about that course, say so in one sentence and name the closest lesson
+that is. Never invent a grade, a deadline, a fee or a policy: those belong to the
+registrar, and you say so when asked.`;
+
+async function askModel(
+  settings: { baseUrl: string; apiKey: string; model: string },
+  question: string,
+  context: string,
+): Promise<string | null> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 12_000);
+  try {
+    const response = await fetch(`${settings.baseUrl.replace(/\/+$/, "")}/chat/completions`, {
+      method: "POST",
+      headers: { authorization: `Bearer ${settings.apiKey}`, "content-type": "application/json" },
+      body: JSON.stringify({
+        model: settings.model,
+        temperature: 0.3,
+        max_tokens: 400,
+        messages: [
+          { role: "system", content: SYSTEM },
+          { role: "user", content: `${context}\n\nQuestion: ${question}` },
+        ],
+      }),
+      signal: controller.signal,
+    });
+    if (!response.ok) return null;
+    const body = (await response.json()) as { choices?: { message?: { content?: string } }[] };
+    const answer = body.choices?.[0]?.message?.content?.trim();
+    return answer ? answer.slice(0, 1600) : null;
+  } catch {
+    return null;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/** A true study plan, built from the course record rather than from a model. */
+function studyPlan(course: { title: string; modules: { title: string; summary: string }[] }): string {
+  const steps = course.modules
+    .slice(0, 4)
+    .map((module, index) => `${index + 1}. ${module.title}: ${module.summary}`)
+    .join("\n");
+  return `A plan for ${course.title}, from the course record:\n\n${steps}\n\nStart with the module you could least explain from memory, read its first lesson, then say the idea out loud in one sentence. Marks, deadlines and extensions are the registrar's, so ask them rather than this app.`;
+}
+
+export async function POST(request: Request) {
+  const identity = bearerIdentity(request);
+  if (!identity) return fail("Sign in to use the study coach.", 401);
+  if (identity.role !== "learner") return fail("The study coach belongs to learner accounts.", 403);
+
+  const db = getDb();
+  const learner = db.learners.find((item) => item.id === identity.sub);
+  if (!learner) return fail("That learner account no longer exists.", 401);
+  if (!isPlus(db, learner.id)) {
+    return fail("AthenIQ Plus unlocks the study coach.", 402, { upgrade: "plus" });
+  }
+
+  let body: { question?: unknown; courseId?: unknown; lessonId?: unknown };
+  try {
+    body = (await request.json()) as typeof body;
+  } catch {
+    return fail("Send a JSON body.");
+  }
+  const question = text(body.question, 600);
+  if (question.length < 4) return fail("Ask a question of at least a few words.");
+
+  const courseId = text(body.courseId, 120);
+  const course = courseId
+    ? db.courses.find((item) => item.id === courseId || item.key === courseId) ?? null
+    : null;
+
+  const context: string[] = [];
+  if (course) {
+    context.push(`Course: ${course.code} ${course.title}`);
+    context.push(`Summary: ${course.summary}`);
+    context.push(`Outcomes: ${course.outcomes.join("; ")}`);
+    context.push(
+      `Modules: ${course.modules
+        .map((module) => `${module.title} (${module.lessons.map((lesson) => lesson.title).join(", ")})`)
+        .join(" | ")}`,
+    );
+    const lessonId = text(body.lessonId, 120);
+    const lesson = lessonId
+      ? course.modules.flatMap((module) => module.lessons).find((item) => item.id === lessonId) ?? null
+      : null;
+    if (lesson) context.push(`Lesson in view: ${lesson.title} (${lesson.type}, ${lesson.minutes} min)`);
+  } else {
+    context.push("No course was named; answer about studying in general.");
+  }
+
+  const ai = db.settings.ai;
+  const answer = ai.baseUrl && ai.apiKey ? await askModel(ai, question, context.join("\n")) : null;
+  if (answer) return ok({ answer, source: "model" as const, courseId: course?.id ?? null });
+  if (!course) {
+    return fail("Name a course so the coach has something true to work from.", 422, { upgrade: null });
+  }
+  return ok({ answer: studyPlan(course), source: "rules" as const, courseId: course.id });
+}
+
+export function OPTIONS() {
+  return preflight();
+}
