diff --git a/mobile/lib/premium.tsx b/mobile/lib/premium.tsx
new file mode 100644
index 0000000..8b9c368
--- /dev/null
+++ b/mobile/lib/premium.tsx
@@ -0,0 +1,127 @@
+import React, { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react";
+import { api, errorMessage, type PremiumState } from "./api";
+import {
+  configurePurchases,
+  purchaseProduct,
+  purchasesConfigured,
+  restorePurchases,
+} from "./purchases";
+import { useSession } from "./session";
+
+/**
+ * The learner's plan, as the server reports it.
+ *
+ * Nothing here decides access: the coach, analytics and offline quota are
+ * checked again on the server for every call. This context exists so the app
+ * can show the right label, hide a dead end behind a paywall, and refresh the
+ * plan after a purchase or a restore.
+ */
+interface PremiumContextValue {
+  premium: PremiumState | null;
+  loading: boolean;
+  error: string;
+  purchasing: string | null;
+  /** True when this build has public store keys. */
+  available: boolean;
+  /** True when the server can verify receipts. */
+  storeConfigured: boolean;
+  isPlus: boolean;
+  refresh: () => Promise<void>;
+  buy: (productId: string) => Promise<{ purchased: boolean; cancelled: boolean }>;
+  restore: () => Promise<void>;
+}
+
+const Context = createContext<PremiumContextValue | null>(null);
+
+/**
+ * RevenueCat's app user id is the learner id. Sessions stored before the id was
+ * kept fall back to the email, which the webhook also accepts.
+ */
+function appUserId(learner: { id?: string; email: string }): string {
+  return learner.id || learner.email;
+}
+
+export function PremiumProvider({ children }: { children: React.ReactNode }) {
+  const { learner } = useSession();
+  const [premium, setPremium] = useState<PremiumState | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+  const [purchasing, setPurchasing] = useState<string | null>(null);
+
+  const refresh = useCallback(async () => {
+    if (!learner) {
+      setPremium(null);
+      setError("");
+      return;
+    }
+    setLoading(true);
+    try {
+      setPremium(await api.premium(learner.token));
+      setError("");
+    } catch (caught) {
+      setError(errorMessage(caught));
+    } finally {
+      setLoading(false);
+    }
+  }, [learner]);
+
+  useEffect(() => {
+    if (!learner) {
+      setPremium(null);
+      return;
+    }
+    configurePurchases(appUserId(learner));
+    refresh();
+  }, [learner, refresh]);
+
+  const buy = useCallback(
+    async (productId: string) => {
+      if (!learner) throw new Error("Sign in first.");
+      if (!configurePurchases(appUserId(learner))) {
+        throw new Error("Subscriptions are available in the App Store and Play Store builds.");
+      }
+      setPurchasing(productId);
+      try {
+        const result = await purchaseProduct(productId);
+        if (result.purchased) setPremium(await api.syncPremium(learner.token));
+        return result;
+      } finally {
+        setPurchasing(null);
+      }
+    },
+    [learner],
+  );
+
+  const restore = useCallback(async () => {
+    if (!learner) throw new Error("Sign in first.");
+    if (!configurePurchases(appUserId(learner))) {
+      throw new Error("Subscriptions are available in the App Store and Play Store builds.");
+    }
+    await restorePurchases();
+    setPremium(await api.syncPremium(learner.token));
+  }, [learner]);
+
+  const value = useMemo<PremiumContextValue>(
+    () => ({
+      premium,
+      loading,
+      error,
+      purchasing,
+      available: purchasesConfigured,
+      storeConfigured: premium?.storeConfigured !== false,
+      isPlus: premium?.plan === "plus",
+      refresh,
+      buy,
+      restore,
+    }),
+    [premium, loading, error, purchasing, refresh, buy, restore],
+  );
+
+  return <Context.Provider value={value}>{children}</Context.Provider>;
+}
+
+export function usePremium(): PremiumContextValue {
+  const value = useContext(Context);
+  if (!value) throw new Error("usePremium must be used inside PremiumProvider");
+  return value;
+}
