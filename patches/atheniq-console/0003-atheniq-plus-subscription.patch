diff --git a/app/api/mobile/v1/premium/route.ts b/app/api/mobile/v1/premium/route.ts
new file mode 100644
index 0000000..369f003
--- /dev/null
+++ b/app/api/mobile/v1/premium/route.ts
@@ -0,0 +1,29 @@
+import { getDb } from "@/lib/store";
+import { fail, ok, preflight } from "@/lib/mobile-api";
+import { bearerIdentity } from "@/lib/mobile-auth";
+import { premiumSnapshot } from "@/lib/premium";
+import { revenueCatSettings } from "@/lib/revenuecat";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * What this learner's account includes, straight from the server.
+ *
+ * The app uses this to draw the paywall and the locks, never to grant access:
+ * the coach and analytics routes check the same row again on every call.
+ */
+export async function GET(request: Request) {
+  const identity = bearerIdentity(request);
+  if (!identity) return fail("Sign in.", 401);
+  if (identity.role !== "learner") return fail("Memberships belong to learner accounts.", 403);
+
+  const db = getDb();
+  const learner = db.learners.find((item) => item.id === identity.sub);
+  if (!learner) return fail("That learner account no longer exists.", 401);
+
+  return ok({ ...premiumSnapshot(db, learner.id), storeConfigured: Boolean(revenueCatSettings()) });
+}
+
+export function OPTIONS() {
+  return preflight();
+}
diff --git a/app/api/mobile/v1/premium/sync/route.ts b/app/api/mobile/v1/premium/sync/route.ts
new file mode 100644
index 0000000..c25e19c
--- /dev/null
+++ b/app/api/mobile/v1/premium/sync/route.ts
@@ -0,0 +1,66 @@
+import { getDb, mutate } from "@/lib/store";
+import { fail, ok, preflight } from "@/lib/mobile-api";
+import { bearerIdentity } from "@/lib/mobile-auth";
+import { membershipOf, premiumSnapshot, upsertMembership } from "@/lib/premium";
+import {
+  fetchSubscriber,
+  membershipFromSubscriber,
+  revenueCatSettings,
+} from "@/lib/revenuecat";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * Called after a purchase, a restore, or a cold launch.
+ *
+ * The phone sends no receipt and no plan. We ask RevenueCat what this learner
+ * owns, with a key that never leaves the server, and store the answer. If the
+ * store side is not configured the route refuses rather than pretending: a
+ * client cannot mint its own subscription.
+ */
+export async function POST(request: Request) {
+  const identity = bearerIdentity(request);
+  if (!identity) return fail("Sign in.", 401);
+  if (identity.role !== "learner") return fail("Memberships belong to learner accounts.", 403);
+
+  const settings = revenueCatSettings();
+  if (!settings) {
+    return fail("In-app purchases are not configured on this server yet.", 503, { storeConfigured: false });
+  }
+
+  const db = getDb();
+  const learner = db.learners.find((item) => item.id === identity.sub);
+  if (!learner) return fail("That learner account no longer exists.", 401);
+
+  let lookup;
+  try {
+    lookup = await fetchSubscriber(learner.id, settings);
+  } catch (error) {
+    return fail(
+      error instanceof Error ? error.message : "The store could not be reached. Try again.",
+      502,
+      { storeConfigured: true },
+    );
+  }
+
+  const membership = membershipFromSubscriber(learner.id, lookup, settings);
+  await mutate((database) => {
+    if (membership) {
+      upsertMembership(database, membership);
+      return;
+    }
+    // No entitlement at RevenueCat: a lapsed subscription ends here, but a
+    // registrar's grant is not something a store lookup can take away.
+    const existing = membershipOf(database, learner.id);
+    if (existing && existing.store !== "granted") {
+      existing.status = "expired";
+      existing.updatedAt = new Date().toISOString();
+    }
+  });
+
+  return ok({ ...premiumSnapshot(getDb(), learner.id), storeConfigured: true });
+}
+
+export function OPTIONS() {
+  return preflight();
+}
diff --git a/lib/premium.ts b/lib/premium.ts
new file mode 100644
index 0000000..8eb7dc1
--- /dev/null
+++ b/lib/premium.ts
@@ -0,0 +1,134 @@
+import type { Database, Membership } from "./types";
+
+/**
+ * AthenIQ Plus.
+ *
+ * The app is free: anyone can browse the catalog, enroll in a free course,
+ * read every lesson, keep progress and collect certificates. Plus is a
+ * subscription for the things a phone can do that a notebook cannot: keeping
+ * the whole library offline, an AI study coach, and study analytics.
+ *
+ * Entitlement is decided here, on the server, from a membership row. The phone
+ * never sends a plan: it asks who it is, and this module answers. A client that
+ * claims to be a subscriber without a row is simply a free account.
+ */
+
+export type Plan = "free" | "plus";
+
+export const PLUS = {
+  entitlementId: "plus",
+  monthlyProductId: "institute.atheniq.plus.monthly",
+  yearlyProductId: "institute.atheniq.plus.yearly",
+} as const;
+
+/** The product ids the stores and the phone both use. */
+export const PLUS_PRODUCTS = [
+  { id: PLUS.monthlyProductId, label: "AthenIQ Plus · monthly", period: "month" },
+  { id: PLUS.yearlyProductId, label: "AthenIQ Plus · yearly", period: "year" },
+] as const;
+
+/** How many courses a free account may keep on the device at once. */
+export const FREE_OFFLINE_COURSES = 1;
+
+export interface PremiumSnapshot {
+  plan: Plan;
+  status: "free" | "active" | "granted" | "expired" | "refunded";
+  source: Membership["store"] | null;
+  productId: string | null;
+  startedAt: string | null;
+  expiresAt: string | null;
+  features: {
+    /** null means no limit. */
+    offlineCourses: number | null;
+    coach: boolean;
+    analytics: boolean;
+    priorityReview: boolean;
+  };
+  offline: { used: number; limit: number | null };
+  products: { id: string; label: string; period: string }[];
+}
+
+/**
+ * A paid row is only a membership while it has not lapsed. A grant without an
+ * expiry is a registrar's decision and stays until the registrar revokes it.
+ */
+function active(membership: Membership | null, now: Date): boolean {
+  if (!membership) return false;
+  if (membership.status !== "active" && membership.status !== "granted") return false;
+  return membership.expiresAt === null || Date.parse(membership.expiresAt) > now.getTime();
+}
+
+export function membershipOf(db: Database, learnerId: string): Membership | null {
+  return (db.memberships ?? []).find((row) => row.learnerId === learnerId) ?? null;
+}
+
+export function isPlus(db: Database, learnerId: string, now = new Date()): boolean {
+  return active(membershipOf(db, learnerId), now);
+}
+
+/** Distinct courses this learner has downloaded, newest record per course. */
+export function offlineCourseIds(db: Database, learnerId: string): string[] {
+  const ids = (db.downloads ?? [])
+    .filter((row) => row.learnerId === learnerId)
+    .map((row) => row.courseId);
+  return [...new Set(ids)];
+}
+
+/**
+ * Whether another download may start. Re-downloading a course the learner
+ * already keeps offline never counts twice, so a free account is not punished
+ * for refreshing the one it has.
+ */
+export function downloadAllowed(
+  db: Database,
+  learnerId: string,
+  courseId: string,
+  now = new Date(),
+): boolean {
+  if (isPlus(db, learnerId, now)) return true;
+  const kept = offlineCourseIds(db, learnerId);
+  return kept.includes(courseId) || kept.length < FREE_OFFLINE_COURSES;
+}
+
+export function recordDownload(
+  db: Database,
+  learnerId: string,
+  courseId: string,
+  now = new Date(),
+): void {
+  if (!Array.isArray(db.downloads)) db.downloads = [];
+  const at = now.toISOString();
+  const existing = db.downloads.find((row) => row.learnerId === learnerId && row.courseId === courseId);
+  if (existing) existing.at = at;
+  else db.downloads.push({ learnerId, courseId, at });
+}
+
+export function premiumSnapshot(db: Database, learnerId: string, now = new Date()): PremiumSnapshot {
+  const membership = membershipOf(db, learnerId);
+  const plus = active(membership, now);
+  const used = offlineCourseIds(db, learnerId).length;
+  return {
+    plan: plus ? "plus" : "free",
+    status: membership ? (plus ? membership.status : "expired") : "free",
+    source: membership?.store ?? null,
+    productId: membership?.productId ?? null,
+    startedAt: membership?.startedAt ?? null,
+    expiresAt: membership?.expiresAt ?? null,
+    features: {
+      offlineCourses: plus ? null : FREE_OFFLINE_COURSES,
+      coach: plus,
+      analytics: plus,
+      priorityReview: plus,
+    },
+    offline: { used, limit: plus ? null : FREE_OFFLINE_COURSES },
+    products: PLUS_PRODUCTS.map(({ id, label, period }) => ({ id, label, period })),
+  };
+}
+
+/** One row per learner: a renewal replaces the row it renews. */
+export function upsertMembership(db: Database, next: Membership): void {
+  if (!Array.isArray(db.memberships)) db.memberships = [];
+  const index = db.memberships.findIndex((row) => row.learnerId === next.learnerId);
+  if (index === -1) db.memberships.push(next);
+  else db.memberships[index] = next;
+}
diff --git a/lib/revenuecat.ts b/lib/revenuecat.ts
new file mode 100644
index 0000000..e9e6725
--- /dev/null
+++ b/lib/revenuecat.ts
@@ -0,0 +1,133 @@
+import type { Membership } from "./types";
+
+/** Matches `PLUS.entitlementId`; kept local so this module stands alone. */
+const DEFAULT_ENTITLEMENT_ID = "plus";
+
+/**
+ * RevenueCat is the receipt layer: the stores verify a purchase, RevenueCat
+ * keeps the subscription, and this server reads the result with a secret key.
+ *
+ * The phone never tells us it is subscribed. It asks us to sync; we ask
+ * RevenueCat; the entitlement in the answer is the only thing that becomes a
+ * membership row. Without REVENUECAT_SECRET_KEY the sync route says so and
+ * grants nothing, which is the safe default for a deployment that has not
+ * finished store setup.
+ */
+
+export interface RevenueCatSettings {
+  apiKey: string;
+  entitlementId: string;
+  baseUrl: string;
+}
+
+export function revenueCatSettings(env: NodeJS.ProcessEnv = process.env): RevenueCatSettings | null {
+  const apiKey = (env.REVENUECAT_SECRET_KEY || "").trim();
+  if (!apiKey) return null;
+  return {
+    apiKey,
+    entitlementId: (env.REVENUECAT_ENTITLEMENT_ID || DEFAULT_ENTITLEMENT_ID).trim(),
+    baseUrl: (env.REVENUECAT_BASE_URL || "https://api.revenuecat.com").replace(/\/+$/, ""),
+  };
+}
+
+export interface RevenueCatEntitlement {
+  expires_date?: string | null;
+  purchase_date?: string | null;
+  product_identifier?: string | null;
+}
+
+export interface RevenueCatSubscriber {
+  entitlements?: Record<string, RevenueCatEntitlement | null>;
+}
+
+export interface SubscriberLookup {
+  subscriber: RevenueCatSubscriber | null;
+}
+
+/** An unknown subscriber is 404, which is simply "no purchases yet". */
+export async function fetchSubscriber(
+  learnerId: string,
+  settings: RevenueCatSettings,
+  fetchImpl: typeof fetch = fetch,
+): Promise<SubscriberLookup> {
+  const response = await fetchImpl(`${settings.baseUrl}/v1/subscribers/${encodeURIComponent(learnerId)}`, {
+    headers: { authorization: `Bearer ${settings.apiKey}`, accept: "application/json" },
+    cache: "no-store",
+  });
+  if (response.status === 404) return { subscriber: null };
+  if (!response.ok) throw new Error(`RevenueCat answered ${response.status}`);
+  const body = (await response.json()) as { subscriber?: RevenueCatSubscriber };
+  return { subscriber: body.subscriber ?? null };
+}
+
+export function membershipFromSubscriber(
+  learnerId: string,
+  lookup: SubscriberLookup,
+  settings: RevenueCatSettings,
+  now = new Date(),
+): Membership | null {
+  const entitlement = lookup.subscriber?.entitlements?.[settings.entitlementId] ?? null;
+  if (!entitlement) return null;
+  const expiresAt = entitlement.expires_date ? new Date(entitlement.expires_date).toISOString() : null;
+  const startedAt = entitlement.purchase_date
+    ? new Date(entitlement.purchase_date).toISOString()
+    : now.toISOString();
+  const current = expiresAt === null || Date.parse(expiresAt) > now.getTime();
+  return {
+    learnerId,
+    plan: "plus",
+    status: current ? "active" : "expired",
+    store: "revenuecat",
+    productId: entitlement.product_identifier ?? null,
+    originalTransactionId: null,
+    startedAt,
+    expiresAt,
+    updatedAt: now.toISOString(),
+    lastEventId: null,
+  };
+}
+
+/** The shape RevenueCat posts to a webhook. */
+export interface RevenueCatEvent {
+  id?: string;
+  type?: string;
+  app_user_id?: string;
+  product_id?: string | null;
+  purchased_at_ms?: number | null;
+  expiration_at_ms?: number | null;
+  original_transaction_id?: string | null;
+  store?: string | null;
+}
+
+/**
+ * Renewals, expirations and refunds arrive here. A cancellation only turns off
+ * auto-renew: the learner keeps what they paid for until `expiration_at_ms`.
+ */
+export function membershipFromEvent(
+  event: RevenueCatEvent,
+  learnerId: string,
+  now = new Date(),
+): Membership | null {
+  const type = (event.type || "").toUpperCase();
+  if (!type) return null;
+  const refunded = type === "REFUND";
+  const expired = type === "EXPIRATION" || type === "SUBSCRIPTION_PAUSED";
+  const expiresAt =
+    typeof event.expiration_at_ms === "number" ? new Date(event.expiration_at_ms).toISOString() : null;
+  const startedAt =
+    typeof event.purchased_at_ms === "number" ? new Date(event.purchased_at_ms).toISOString() : now.toISOString();
+  const store =
+    event.store === "APP_STORE" ? "app_store" : event.store === "PLAY_STORE" ? "play_store" : "revenuecat";
+  return {
+    learnerId,
+    plan: "plus",
+    status: refunded ? "refunded" : expired ? "expired" : "active",
+    store,
+    productId: event.product_id ?? null,
+    originalTransactionId: event.original_transaction_id ?? null,
+    startedAt,
+    expiresAt,
+    updatedAt: now.toISOString(),
+    lastEventId: event.id ?? null,
+  };
+}
