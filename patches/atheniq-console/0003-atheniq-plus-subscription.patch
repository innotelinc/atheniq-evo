new file mode 100644
index 0000000..7a6f482
--- /dev/null
+++ b/scripts/premium-test.mjs
@@ -0,0 +1,164 @@
+/**
+ * Premium rules without a server.
+ *
+ * These are the parts that must not be wrong: who counts as a subscriber, what
+ * the free tier may keep offline, and how a store event becomes a membership.
+ * They run against the real modules, so a change in the mapping breaks a test
+ * rather than a learner's access.
+ */
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  FREE_OFFLINE_COURSES,
+  downloadAllowed,
+  isPlus,
+  premiumSnapshot,
+  recordDownload,
+  upsertMembership,
+} from "../lib/premium.ts";
+import {
+  fetchSubscriber,
+  membershipFromEvent,
+  membershipFromSubscriber,
+  revenueCatSettings,
+} from "../lib/revenuecat.ts";
+
+const NOW = new Date("2026-11-26T12:00:00Z");
+const FUTURE = "2026-12-26T12:00:00.000Z";
+const PAST = "2026-10-26T12:00:00.000Z";
+const emptyDb = () => ({ memberships: [], downloads: [] });
+
+function membership(overrides = {}) {
+  return {
+    learnerId: "lrn_1",
+    plan: "plus",
+    status: "active",
+    store: "app_store",
+    productId: "institute.atheniq.plus.monthly",
+    originalTransactionId: "tx_1",
+    startedAt: NOW.toISOString(),
+    expiresAt: FUTURE,
+    updatedAt: NOW.toISOString(),
+    lastEventId: null,
+    ...overrides,
+  };
+}
+
+test("a free account may keep one course offline, and re-downloading it is free", () => {
+  const db = emptyDb();
+  const snapshot = premiumSnapshot(db, "lrn_1", NOW);
+  assert.equal(snapshot.plan, "free");
+  assert.equal(snapshot.offline.limit, FREE_OFFLINE_COURSES);
+  assert.equal(snapshot.features.coach, false);
+
+  assert.equal(downloadAllowed(db, "lrn_1", "course_a", NOW), true);
+  recordDownload(db, "lrn_1", "course_a", NOW);
+  assert.equal(downloadAllowed(db, "lrn_1", "course_a", NOW), true, "refreshing the same course is allowed");
+  assert.equal(downloadAllowed(db, "lrn_1", "course_b", NOW), false, "a second course needs Plus");
+
+  const after = premiumSnapshot(db, "lrn_1", NOW);
+  assert.equal(after.offline.used, 1);
+});
+
+test("an active, a lapsed and a granted membership each read correctly", () => {
+  const db = emptyDb();
+  upsertMembership(db, membership());
+  assert.equal(isPlus(db, "lrn_1", NOW), true);
+  assert.equal(premiumSnapshot(db, "lrn_1", NOW).features.offlineCourses, null, "Plus has no offline limit");
+  assert.equal(downloadAllowed(db, "lrn_1", "course_b", NOW), true);
+
+  upsertMembership(db, membership({ expiresAt: PAST }));
+  assert.equal(isPlus(db, "lrn_1", NOW), false);
+  assert.equal(premiumSnapshot(db, "lrn_1", NOW).status, "expired");
+
+  upsertMembership(db, membership({ status: "granted", store: "granted", expiresAt: null }));
+  assert.equal(isPlus(db, "lrn_1", NOW), true, "a grant with no expiry does not lapse");
+
+  upsertMembership(db, membership({ status: "refunded" }));
+  assert.equal(isPlus(db, "lrn_1", NOW), false, "a refund ends access");
+  assert.equal(db.memberships.length, 1, "one row per learner");
+});
+
+test("RevenueCat settings stay off until a secret key is set", () => {
+  assert.equal(revenueCatSettings({}), null);
+  const settings = revenueCatSettings({ REVENUECAT_SECRET_KEY: "sk_test" });
+  assert.equal(settings?.entitlementId, "plus");
+  assert.equal(settings?.baseUrl, "https://api.revenuecat.com");
+});
+
+test("a subscriber lookup becomes a membership only through the entitlement", () => {
+  const settings = revenueCatSettings({ REVENUECAT_SECRET_KEY: "sk_test" });
+  assert.ok(settings);
+
+  const entitled = membershipFromSubscriber(
+    "lrn_1",
+    {
+      subscriber: {
+        entitlements: {
+          plus: { expires_date: FUTURE, purchase_date: NOW.toISOString(), product_identifier: "institute.atheniq.plus.yearly" },
+        },
+      },
+    },
+    settings,
+    NOW,
+  );
+  assert.equal(entitled?.status, "active");
+  assert.equal(entitled?.productId, "institute.atheniq.plus.yearly");
+
+  const wrongEntitlement = membershipFromSubscriber(
+    "lrn_1",
+    { subscriber: { entitlements: { pro: { expires_date: FUTURE } } } },
+    settings,
+    NOW,
+  );
+  assert.equal(wrongEntitlement, null, "an entitlement the app does not sell grants nothing");
+
+  const unknown = membershipFromSubscriber("lrn_1", { subscriber: null }, settings, NOW);
+  assert.equal(unknown, null);
+});
+
+test("an unknown subscriber is 404, and a broken key is an error", async () => {
+  const settings = revenueCatSettings({ REVENUECAT_SECRET_KEY: "sk_test" });
+  assert.ok(settings);
+  const notFound = async () => new Response("{}", { status: 404 });
+  assert.deepEqual(await fetchSubscriber("lrn_1", settings, notFound), { subscriber: null });
+
+  const rejected = async () => new Response("{}", { status: 401 });
+  await assert.rejects(() => fetchSubscriber("lrn_1", settings, rejected), /401/);
+});
+
+test("store events renew, lapse and refund without ever shortening a paid term early", () => {
+  const renewal = membershipFromEvent(
+    {
+      id: "evt_2",
+      type: "RENEWAL",
+      app_user_id: "lrn_1",
+      product_id: "institute.atheniq.plus.monthly",
+      purchased_at_ms: NOW.getTime(),
+      expiration_at_ms: Date.parse(FUTURE),
+      store: "APP_STORE",
+    },
+    "lrn_1",
+    NOW,
+  );
+  assert.equal(renewal?.status, "active");
+  assert.equal(renewal?.store, "app_store");
+  assert.equal(renewal?.lastEventId, "evt_2");
+
+  const cancelled = membershipFromEvent(
+    { type: "CANCELLATION", app_user_id: "lrn_1", expiration_at_ms: Date.parse(FUTURE) },
+    "lrn_1",
+    NOW,
+  );
+  assert.equal(cancelled?.status, "active", "auto-renew off is not a refund");
+
+  const expired = membershipFromEvent(
+    { type: "EXPIRATION", app_user_id: "lrn_1", expiration_at_ms: Date.parse(PAST) },
+    "lrn_1",
+    NOW,
+  );
+  assert.equal(expired?.status, "expired");
+
+  const refunded = membershipFromEvent({ type: "REFUND", app_user_id: "lrn_1" }, "lrn_1", NOW);
+  assert.equal(refunded?.status, "refunded");
+});
