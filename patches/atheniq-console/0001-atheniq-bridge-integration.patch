@@ -0,0 +1,74 @@
+﻿import { NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { getDb } from "@/lib/store";
+import { PORTAL_COOKIE, readPortalSession } from "@/lib/portal";
+import { bridgeConfig, classroomTicket } from "@/lib/bridge";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * "AI classroom" — from the student portal into the AI classroom for one course.
+ *
+ * Three things have to be true at once, and each has one owner:
+ *
+ * 1. the learner is signed in to the portal (its own signed cookie),
+ * 2. the course is unlocked (payment settled), and
+ * 3. the bridge vouches for the pair (the signed classroom token).
+ *
+ * The console does not mint the token: the bridge does, because OpenMAIC trusts
+ * the bridge's key and nothing else. The console only delivers it — as an
+ * HttpOnly cookie on the estate's parent domain, then redirects.
+ */
+export async function GET(request: Request) {
+  const origin = new URL(request.url).origin;
+  const note = (message: string) =>
+    NextResponse.redirect(new URL(`/portal?note=${encodeURIComponent(message)}`, origin), 303);
+
+  const config = bridgeConfig();
+  if (!config) return note("The AI classroom is not configured on this console yet.");
+
+  const learnerId = readPortalSession((await cookies()).get(PORTAL_COOKIE)?.value);
+  if (!learnerId) {
+    return NextResponse.redirect(new URL("/portal/login", origin), 303);
+  }
+
+  const db = getDb();
+  const learner = db.learners.find((item) => item.id === learnerId);
+  if (!learner) return NextResponse.redirect(new URL("/portal/login", origin), 303);
+
+  const url = new URL(request.url);
+  const enrollmentId = url.searchParams.get("enrollmentId") ?? "";
+  const courseKeyParam = url.searchParams.get("courseKey") ?? "";
+
+  const enrollment = enrollmentId
+    ? db.enrollments.find((item) => item.id === enrollmentId && item.learnerId === learner.id)
+    : db.enrollments.find((item) => item.learnerId === learner.id && item.courseKey === courseKeyParam);
+
+  if (!enrollment) return note("There is no enrollment to open a classroom for.");
+  if (enrollment.access === "pending_payment") {
+    return note("Settle the course payment before opening its AI classroom.");
+  }
+
+  const signed = await classroomTicket(config, {
+    learnerId: learner.id,
+    name: learner.name,
+    email: learner.email,
+    courseKey: enrollment.courseKey,
+    lmsUsername: learner.username,
+  });
+  if (!signed.ok) return note(signed.error);
+
+  const response = NextResponse.redirect(signed.ticket.classroomUrl, 303);
+  response.cookies.set("atheniq_classroom", signed.ticket.token, {
+    httpOnly: true,
+    sameSite: "lax",
+    // A shared parent domain is what lets OpenMAIC, on its own host, read it.
+    // Without the env the cookie stays on this host, which is correct only when
+    // the console and the classroom share an origin.
+    domain: (process.env.ATHENIQ_CLASSROOM_COOKIE_DOMAIN || "").trim() || undefined,
+    path: "/",
+    maxAge: Math.max(60, signed.ticket.expiresIn),
+    secure: process.env.NODE_ENV === "production",
+  });
+  return response;
+}
