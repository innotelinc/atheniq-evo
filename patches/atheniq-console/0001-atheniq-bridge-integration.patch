diff --git a/lib/award.ts b/lib/award.ts
new file mode 100644
index 0000000..e3c66d8
--- /dev/null
+++ b/lib/award.ts
@@ -0,0 +1,235 @@
+﻿import fs from "node:fs";
+import path from "node:path";
+import { getDb, logActivity, mutate, newId, nowIso, verifyId } from "./store";
+import { evidenceHash, submitToSignara } from "./signara";
+import { programEligibility, trackEligibility } from "./eligibility";
+import type { ActorRef, Credential, CredentialType, Learner } from "./types";
+
+/**
+ * Awarding a credential, once.
+ *
+ * This was the body of `POST /api/credentials`. It lives here because there are
+ * now two callers: a registrar in the award center, and the AthenIQ bridge
+ * closing an AI classroom. Duplicating the eligibility rules, the evidence hash
+ * and the three-call Signara flow in a second place would let the two paths
+ * drift, and a credential is not a thing to have two implementations of.
+ *
+ * It still returns refusals rather than throwing, because both callers answer a
+ * learner or an operator with the reason.
+ */
+
+export const AWARD_TYPES: CredentialType[] = ["course_certificate", "track_credential", "degree_conferral"];
+
+export interface AwardRequest {
+  type?: string;
+  subjectRef?: string;
+  learnerId?: string;
+  learner?: { username?: string; name?: string; email?: string };
+  grade?: string;
+  completedOn?: string;
+  credits?: number;
+  gpa?: string;
+  override?: boolean;
+  autoSign?: boolean;
+}
+
+export type AwardResult =
+  | { ok: true; credential: Credential }
+  | { ok: false; status: number; error: string };
+
+function str(value: unknown, fallback = ""): string {
+  return typeof value === "string" ? value.trim() : fallback;
+}
+
+/** The actor recorded on the trail; the bridge signs its work as itself. */
+export const BRIDGE_ACTOR: ActorRef = {
+  id: "atheniq-bridge",
+  name: "AthenIQ bridge",
+  email: "bridge@atheniq.institute",
+  role: "registrar",
+};
+
+export async function awardCredential(
+  body: AwardRequest,
+  actor: ActorRef | null,
+): Promise<AwardResult> {
+  const type = str(body.type) as CredentialType;
+  const subjectRef = str(body.subjectRef);
+  if (!AWARD_TYPES.includes(type)) return { ok: false, status: 400, error: "Choose a credential type." };
+  if (!subjectRef) return { ok: false, status: 400, error: "Choose what the award is for." };
+
+  const db = getDb();
+  const settings = db.settings;
+
+  // Resolve the learner: an existing record, or a new one from the form.
+  let learner: Learner | undefined = body.learnerId
+    ? db.learners.find((item) => item.id === body.learnerId)
+    : undefined;
+
+  if (!learner && body.learner?.email) {
+    const email = str(body.learner.email).toLowerCase();
+    learner =
+      db.learners.find((item) => item.email.toLowerCase() === email) ??
+      (await mutate((database) => {
+        const created: Learner = {
+          id: newId("lrn"),
+          username: str(body.learner?.username) || email.split("@")[0],
+          name: str(body.learner?.name) || email.split("@")[0],
+          email: str(body.learner!.email),
+          programId: type === "degree_conferral" ? subjectRef : null,
+          enrolledAt: nowIso(),
+        };
+        database.learners.push(created);
+        return created;
+      }));
+  }
+
+  if (!learner) return { ok: false, status: 400, error: "Choose a learner, or give a name and email." };
+  const learnerRecord = learner;
+
+  let title = "";
+  let subjectLabel = "";
+  let template = settings.signara.defaultTemplate;
+  let evidence: Credential["evidence"] = {};
+
+  if (type === "course_certificate") {
+    const course = db.courses.find((item) => item.key === subjectRef);
+    if (!course) return { ok: false, status: 404, error: "That course is not in the catalog." };
+    const completion = db.completions.find(
+      (item) => item.learnerId === learnerRecord.id && item.courseKey === course.key && item.status === "pass",
+    );
+    if (!completion && !body.override) {
+      return {
+        ok: false,
+        status: 422,
+        error: `${learnerRecord.name} has no passing completion for ${course.code}. Use the manual override to award anyway.`,
+      };
+    }
+    title = `${course.title} — Certificate of Completion (${learnerRecord.name})`;
+    subjectLabel = course.title;
+    template = settings.signara.defaultTemplate;
+    evidence = {
+      grade: str(body.grade) || completion?.grade || "Pass",
+      completedOn: str(body.completedOn) || completion?.completedOn || nowIso().slice(0, 10),
+      courses: [course.key],
+    };
+  } else if (type === "track_credential") {
+    const track = db.tracks.find((item) => item.id === subjectRef);
+    if (!track) return { ok: false, status: 404, error: "That track does not exist." };
+    const eligibility = trackEligibility(db, track, learnerRecord);
+    if (!eligibility.eligible && !body.override) {
+      return {
+        ok: false,
+        status: 422,
+        error: `${learnerRecord.name} has ${eligibility.missing.length} course(s) outstanding on ${track.title}. Use the manual override to award anyway.`,
+      };
+    }
+    title = `${track.credential.title} (${learnerRecord.name})`;
+    subjectLabel = track.credential.title;
+    template = track.credential.signara_template || settings.signara.defaultTemplate;
+    evidence = {
+      grade: "Pass",
+      completedOn: str(body.completedOn) || nowIso().slice(0, 10),
+      courses: track.courses,
+    };
+  } else {
+    const program = db.programs.find((item) => item.id === subjectRef);
+    if (!program) return { ok: false, status: 404, error: "That program does not exist." };
+    const eligibility = programEligibility(db, program, learnerRecord);
+    if (!eligibility.eligible && !body.override) {
+      return {
+        ok: false,
+        status: 422,
+        error: `${learnerRecord.name} has ${eligibility.creditsEarned} of ${eligibility.creditsRequired} credits. Use the manual override to confer anyway.`,
+      };
+    }
+    title = `${program.credential} — ${learnerRecord.name}`;
+    subjectLabel = program.credential;
+    template = program.signaraTemplate || "degree-conferral";
+    evidence = {
+      credits: body.credits ?? eligibility.creditsEarned,
+      gpa: str(body.gpa) || eligibility.gpa,
+      program: program.name,
+      completedOn: str(body.completedOn) || nowIso().slice(0, 10),
+    };
+  }
+
+  const at = nowIso();
+  const withoutHash: Omit<Credential, "hash"> = {
+    id: newId("cred"),
+    verifyId: verifyId(),
+    type,
+    title,
+    subjectRef,
+    subjectLabel,
+    learner: {
+      username: learnerRecord.username,
+      name: learnerRecord.name,
+      email: learnerRecord.email,
+    },
+    evidence,
+    status: "draft",
+    signara: {
+      documentId: null,
+      requestId: null,
+      signerToken: null,
+      apiBase: null,
+      lastHttp: null,
+      lastError: null,
+    },
+    template,
+    signer: settings.signer,
+    previewPath: null,
+    createdAt: at,
+    updatedAt: at,
+    signedAt: null,
+    issuedAt: null,
+    revokedAt: null,
+    revokeReason: null,
+    timeline: [{ at, label: "Award created", detail: `${type.replace(/_/g, " ")} — ${subjectLabel}` }],
+  };
+
+  const credential: Credential = { ...withoutHash, hash: evidenceHash(withoutHash) };
+
+  const signing = await submitToSignara(credential, {
+    ...settings.signara,
+    autoSign: body.autoSign === undefined ? settings.signara.autoSign : Boolean(body.autoSign),
+  });
+
+  // Keep the exact document that was sent for signing on disk.
+  const certDir = path.join(process.cwd(), "data", "certificates");
+  fs.mkdirSync(certDir, { recursive: true });
+  fs.writeFileSync(path.join(certDir, `${credential.verifyId}.pdf`), signing.pdf);
+  credential.previewPath = `/api/credentials/${credential.id}/certificate`;
+  credential.timeline.push(...signing.timeline);
+
+  if (signing.status === "signed") {
+    credential.status = "issued";
+    credential.signedAt = nowIso();
+    credential.issuedAt = credential.signedAt;
+    credential.timeline.push({ at: credential.issuedAt, label: "Issued to learner record" });
+  } else if (signing.status === "partial") {
+    credential.status = "partial";
+  } else if (signing.status === "failed") {
+    credential.status = "failed";
+  } else {
+    credential.status = "queued_local";
+  }
+
+  credential.signara = signing.signara;
+  credential.updatedAt = nowIso();
+
+  const saved = await mutate((database) => {
+    database.credentials.unshift(credential);
+    logActivity(
+      database,
+      credential.status === "issued" ? "credential.signed" : "credential.issued",
+      `${credential.status === "issued" ? "Signed and issued" : "Staged"} ${subjectLabel} for ${credential.learner.name}`,
+      credential.id,
+      actor,
+    );
+    return credential;
+  });
+
+  return { ok: true, credential: saved };
+}
