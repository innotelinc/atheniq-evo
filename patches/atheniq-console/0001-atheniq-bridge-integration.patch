+﻿/**
+ * The AthenIQ bridge, from the console's side.
+ *
+ * The bridge owns classroom launches and the completion fan-out; the console
+ * owns people and awards. Server-side only: the service token must never reach
+ * a browser, and every call here carries it.
+ */
+
+export interface BridgeConfig {
+  baseUrl: string;
+  serviceToken: string;
+}
+
+export function bridgeConfig(): BridgeConfig | null {
+  const baseUrl = (process.env.ATHENIQ_BRIDGE_URL ?? "").trim().replace(/\/+$/, "");
+  const serviceToken = (process.env.ATHENIQ_BRIDGE_SERVICE_TOKEN ?? "").trim();
+  return baseUrl && serviceToken ? { baseUrl, serviceToken } : null;
+}
+
+async function call<T>(
+  config: BridgeConfig,
+  path: string,
+  body?: unknown,
+  timeoutMs = 20_000,
+): Promise<{ ok: boolean; status: number; data: T | null; error: string | null }> {
+  try {
+    const response = await fetch(`${config.baseUrl}${path}`, {
+      method: body === undefined ? "GET" : "POST",
+      headers: {
+        accept: "application/json",
+        authorization: `Bearer ${config.serviceToken}`,
+        ...(body === undefined ? {} : { "content-type": "application/json" }),
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(timeoutMs),
+      cache: "no-store",
+    });
+    const text = await response.text();
+    let parsed: { data?: T; error?: { message?: string } } | null = null;
+    try {
+      parsed = text ? JSON.parse(text) : null;
+    } catch {
+      parsed = null;
+    }
+    if (!response.ok) {
+      return {
+        ok: false,
+        status: response.status,
+        data: null,
+        error: parsed?.error?.message ?? `The bridge answered HTTP ${response.status}.`,
+      };
+    }
+    return { ok: true, status: response.status, data: (parsed as T | null) ?? null, error: null };
+  } catch (error) {
+    return {
+      ok: false,
+      status: 0,
+      data: null,
+      error: `The bridge is unreachable: ${error instanceof Error ? error.message : String(error)}`,
+    };
+  }
+}
+
+export interface ClassroomTicket {
+  token: string;
+  expiresIn: number;
+  classroomId: string;
+  courseKey: string;
+  classroomUrl: string;
+}
+
+/**
+ * Ask the bridge to sign a learner into their classroom.
+ *
+ * The bridge mints the token; the console sets it as a cookie on the estate's
+ * parent domain, which is what makes it readable by OpenMAIC on its own host
+ * and by nothing else (HttpOnly, so no script can take it).
+ */
+export async function classroomTicket(
+  config: BridgeConfig,
+  input: { learnerId: string; name: string; email: string; courseKey: string; lmsUsername?: string },
+): Promise<{ ok: true; ticket: ClassroomTicket } | { ok: false; error: string }> {
+  const result = await call<ClassroomTicket>(config, "/v1/sso/classroom", input);
+  if (!result.ok || !result.data) return { ok: false, error: result.error ?? "The bridge returned no ticket." };
+  return { ok: true, ticket: result.data };
+}
