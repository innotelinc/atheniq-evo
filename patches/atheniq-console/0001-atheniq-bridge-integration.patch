diff --git a/app/api/internal/atheniq/route.ts b/app/api/internal/atheniq/route.ts
new file mode 100644
index 0000000..469d2fd
--- /dev/null
+++ b/app/api/internal/atheniq/route.ts
@@ -0,0 +1,188 @@
+﻿import { timingSafeEqual } from "node:crypto";
+import { NextResponse } from "next/server";
+import { getDb, logActivity, mutate, newId, nowIso } from "@/lib/store";
+import { BRIDGE_ACTOR, awardCredential, type AwardRequest } from "@/lib/award";
+import { earnedKeys, programEligibility, trackEligibility } from "@/lib/eligibility";
+import type { Completion } from "@/lib/types";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * The bridge's two operations, service-authenticated.
+ *
+ * A registrar uses the console's own screens with a staff session. The bridge is
+ * a machine, so it uses this route and a service token — compared in constant
+ * time, and refused outright when the token is not configured, so a deployment
+ * that forgets it never ends up with an unauthenticated award endpoint.
+ *
+ * `complete-enrollment` is the academically interesting one: it records the
+ * passing completion the AI classroom observed, closes the enrollment, and
+ * answers with everything that completion just made the learner eligible for.
+ * The bridge awards a certificate from that answer and never decides eligibility
+ * itself.
+ */
+
+function authorized(request: Request): boolean {
+  const expected = (process.env.ATHENIQ_BRIDGE_SERVICE_TOKEN ?? "").trim();
+  if (!expected) return false;
+  const header = request.headers.get("authorization") ?? "";
+  const match = /^Bearer\s+(\S+)$/i.exec(header.trim());
+  if (!match) return false;
+  const provided = Buffer.from(match[1] as string);
+  const wanted = Buffer.from(expected);
+  return provided.length === wanted.length && timingSafeEqual(provided, wanted);
+}
+
+function today(): string {
+  return nowIso().slice(0, 10);
+}
+
+interface CompleteBody {
+  action: "complete-enrollment";
+  learnerId?: string;
+  courseKey?: string;
+  grade?: string;
+  completedOn?: string;
+  source?: string;
+  outcomes?: { id: string; label?: string; mastery?: number }[];
+}
+
+interface AwardBody extends AwardRequest {
+  action: "issue-credential";
+}
+
+type Body = CompleteBody | AwardBody;
+
+export async function POST(request: Request) {
+  if (!(process.env.ATHENIQ_BRIDGE_SERVICE_TOKEN ?? "").trim()) {
+    return NextResponse.json(
+      { ok: false, error: "ATHENIQ_BRIDGE_SERVICE_TOKEN is not configured on this console." },
+      { status: 503 },
+    );
+  }
+  if (!authorized(request)) {
+    return NextResponse.json({ ok: false, error: "Service token refused." }, { status: 401 });
+  }
+
+  const body = (await request.json().catch(() => null)) as Body | null;
+  if (!body || typeof body !== "object") {
+    return NextResponse.json({ ok: false, error: "A JSON body is required." }, { status: 400 });
+  }
+
+  if (body.action === "complete-enrollment") {
+    const learnerId = String(body.learnerId ?? "").trim();
+    const courseKey = String(body.courseKey ?? "").trim();
+    if (!learnerId || !courseKey) {
+      return NextResponse.json({ ok: false, error: "learnerId and courseKey are required." }, { status: 400 });
+    }
+
+    const db = getDb();
+    const learner = db.learners.find((item) => item.id === learnerId);
+    if (!learner) {
+      return NextResponse.json({ ok: false, error: "That learner is not in this console." }, { status: 404 });
+    }
+
+    const grade = String(body.grade ?? "").trim().slice(0, 20) || "Pass";
+    const completedOn = String(body.completedOn ?? "").trim().slice(0, 10) || today();
+    const source = String(body.source ?? "ai-classroom").slice(0, 120);
+    const outcomes = Array.isArray(body.outcomes) ? body.outcomes.slice(0, 100) : [];
+
+    const credits = await mutate((store) => {
+      // A learner enrolled in the LMS but not in the console still gains an
+      // enrollment here: the console is the academic record, and an AI
+      // classroom that finished is proof of access, not a request for it.
+      let enrollment = store.enrollments.find(
+        (item) => item.learnerId === learner.id && item.courseKey === courseKey,
+      );
+      if (!enrollment) {
+        enrollment = {
+          id: newId("enr"),
+          learnerId: learner.id,
+          courseId: store.courses.find((course) => course.key === courseKey)?.id ?? courseKey,
+          courseKey,
+          enrolledAt: nowIso(),
+          lastSeenAt: nowIso(),
+          completedLessonIds: [],
+          responses: {},
+          completedAt: null,
+          access: "granted",
+        };
+        store.enrollments.push(enrollment);
+      }
+
+      const already = store.completions.some(
+        (item) =>
+          item.learnerId === learner.id &&
+          item.courseKey === courseKey &&
+          item.completedOn === completedOn &&
+          item.status === "pass",
+      );
+      if (!already) {
+        const completion: Completion = {
+          id: newId("comp"),
+          learnerId: learner.id,
+          courseKey,
+          grade,
+          completedOn,
+          status: "pass",
+        };
+        store.completions.unshift(completion);
+      }
+
+      enrollment.completedAt = completedOn;
+      enrollment.lastSeenAt = nowIso();
+
+      const course = store.courses.find((item) => item.key === courseKey);
+      logActivity(
+        store,
+        "learner.completed",
+        `${BRIDGE_ACTOR.name} recorded a completion (${grade}) for ${learner.name} in ${courseKey}${
+          course ? ` — ${course.title}` : ""
+        }${outcomes.length ? `, ${outcomes.length} outcome(s) evidenced` : ""} [${source}].`,
+        courseKey,
+        BRIDGE_ACTOR,
+      );
+      return course?.credits ?? 0;
+    });
+
+    // What this completion made possible, computed from the store as it now is.
+    const after = getDb();
+    const earned = earnedKeys(after, learner.id);
+    const eligible: string[] = [];
+    if (earned.includes(courseKey) && after.courses.some((course) => course.key === courseKey)) {
+      eligible.push(courseKey);
+    }
+    for (const track of after.tracks) {
+      if (trackEligibility(after, track, learner).eligible) eligible.push(track.id);
+    }
+    for (const program of after.programs) {
+      if (programEligibility(after, program, learner).eligible) eligible.push(program.id);
+    }
+
+    return NextResponse.json({
+      ok: true,
+      data: { learnerId: learner.id, courseKey, completedOn, grade, credits, eligible },
+    });
+  }
+
+  if (body.action === "issue-credential") {
+    const result = await awardCredential(body, BRIDGE_ACTOR);
+    if (!result.ok) {
+      return NextResponse.json({ ok: false, error: result.error }, { status: result.status });
+    }
+    return NextResponse.json(
+      {
+        ok: true,
+        data: {
+          credentialId: result.credential.id,
+          verifyId: result.credential.verifyId,
+          status: result.credential.status,
+          title: result.credential.title,
+        },
+      },
+      { status: 201 },
+    );
+  }
+
+  return NextResponse.json({ ok: false, error: "Unknown action." }, { status: 400 });
+}
