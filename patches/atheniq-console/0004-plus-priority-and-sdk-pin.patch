diff --git a/lib/premium.ts b/lib/premium.ts
index 8eb7dc1..b73edc8 100644
--- a/lib/premium.ts
+++ b/lib/premium.ts
@@ -132,3 +132,54 @@ export function upsertMembership(db: Database, next: Membership): void {
   if (index === -1) db.memberships.push(next);
   else db.memberships[index] = next;
 }
+
+/**
+ * Who holds Plus right now, as lookup keys: `id:<learnerId>` and
+ * `email:<lower-case address>`.
+ *
+ * Both are kept because the records a registrar works from carry an address
+ * rather than the learner id — an award, a purchase or a request names the
+ * person by email. One pass over the memberships keeps the queue's sort from
+ * turning into a lookup per row.
+ */
+export function plusLearnerKeys(db: Database, now = new Date()): Set<string> {
+  const keys = new Set<string>();
+  for (const membership of db.memberships ?? []) {
+    if (!active(membership, now)) continue;
+    keys.add(`id:${membership.learnerId}`);
+    const learner = (db.learners ?? []).find((row) => row.id === membership.learnerId);
+    if (learner) keys.add(`email:${learner.email.toLowerCase()}`);
+  }
+  return keys;
+}
+
+/** Whether this person is named by the keys `plusLearnerKeys` returns. */
+export function isPlusLearner(
+  keys: Set<string>,
+  who: { id?: string | null; email: string },
+): boolean {
+  if (who.id && keys.has(`id:${who.id}`)) return true;
+  return keys.has(`email:${who.email.toLowerCase()}`);
+}
+
+/**
+ * The registrar's queue order: Plus members first, then everyone else, each
+ * group in the order it arrived in.
+ *
+ * This is the one thing the paywall promises that only the console can deliver:
+ * a member's certificate request is seen before a free account's. It is a
+ * tie-breaker, not a bypass — the award still needs the same evidence, the same
+ * registrar and the same signature.
+ */
+export function plusFirst<T>(
+  db: Database,
+  rows: readonly T[],
+  learnerOf: (row: T) => { id?: string | null; email: string },
+  now = new Date(),
+): T[] {
+  const keys = plusLearnerKeys(db, now);
+  const head: T[] = [];
+  const tail: T[] = [];
+  for (const row of rows) (isPlusLearner(keys, learnerOf(row)) ? head : tail).push(row);
+  return [...head, ...tail];
+}
