+
+// The paywall promises members are reviewed first, so the registrar's queue has
+// to actually do it — and a lapsed row must not keep the privilege.
+test("the certificate queue puts Plus members first and leaves the rest in order", () => {
+  const db = {
+    memberships: [],
+    downloads: [],
+    learners: [
+      { id: "lrn_plus", email: "Member@Example.com" },
+      { id: "lrn_lapsed", email: "lapsed@example.com" },
+      { id: "lrn_granted", email: "granted@example.com" },
+    ],
+  };
+  upsertMembership(db, membership({ learnerId: "lrn_plus" }));
+  upsertMembership(
+    db,
+    membership({ learnerId: "lrn_lapsed", status: "expired", expiresAt: PAST }),
+  );
+  upsertMembership(
+    db,
+    membership({ learnerId: "lrn_granted", status: "granted", store: "granted", expiresAt: null }),
+  );
+
+  const queue = [
+    { id: "free-newest", email: "free@example.com" },
+    { id: "member-older", email: "member@example.com" },
+    { id: "lapsed-newest", email: "lapsed@example.com" },
+    { id: "granted-older", email: "granted@example.com" },
+    { id: "stranger-older", email: "stranger@example.com" },
+  ];
+
+  const ordered = plusFirst(db, queue, (row) => ({ email: row.email }), NOW);
+  assert.deepEqual(
+    ordered.map((row) => row.id),
+    ["member-older", "granted-older", "free-newest", "lapsed-newest", "stranger-older"],
+    "members first in their own order, then everyone else in the order they came",
+  );
+  assert.deepEqual(
+    queue.map((row) => row.id),
+    ["free-newest", "member-older", "lapsed-newest", "granted-older", "stranger-older"],
+    "sorting does not mutate the queue it was given",
+  );
+
+  const keys = plusLearnerKeys(db, NOW);
+  assert.equal(isPlusLearner(keys, { email: "MEMBER@example.com" }), true, "addresses match regardless of case");
+  assert.equal(isPlusLearner(keys, { email: "lapsed@example.com" }), false, "a lapsed membership has no priority");
+  assert.equal(isPlusLearner(keys, { id: "lrn_plus", email: "changed@example.com" }), true, "the id still matches");
+});
