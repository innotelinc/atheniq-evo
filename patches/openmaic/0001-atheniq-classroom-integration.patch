index 0000000..78d7fb1
--- /dev/null
+++ b/lib/server/identity/host/atheniq-classroom.ts
@@ -0,0 +1,195 @@
+/**
+ * AthenIQ classroom identity — the host method that makes a learner one person
+ * across the console, the LMS and this classroom.
+ *
+ * The AthenIQ bridge signs a short-lived HS256 token (`atheniq_classroom`) when
+ * the console's launch route sends a learner here. It carries the person id, the
+ * course key and the classroom id. This method verifies it and answers with an
+ * owner principal, so every owner-scoped surface — the library, the persistence
+ * route, materials, agent sessions — is the *same* owner the rest of the estate
+ * knows, with no duplicate account to keep in step.
+ *
+ * Design notes, both deliberate:
+ *
+ * - **A cookie, not a header.** The launch is a browser navigation; nothing can
+ *   attach an Authorization header to it. A host method may read its own cookie
+ *   (see `lib/server/identity/anonymous-cookie.ts`), and this is that cookie.
+ * - **Web Crypto, not a JWT library.** HS256 verification is one
+ *   `crypto.subtle.verify`. Adding `jose` to this app to check a symmetric
+ *   signature would be a dependency for twenty lines of code.
+ *
+ * Absent cookie means `not-applicable`; present-but-bad means `invalid`, so a
+ * forged or expired token can never quietly become an anonymous owner.
+ */
+
+import type { OwnerAuthMethod, OwnerPrincipal } from '@/lib/server/identity';
+
+/** The cookie the console sets, and the only one this method reads. */
+export const ATHENIQ_COOKIE = 'atheniq_classroom';
+
+/** Issuer and audience are pinned; a token minted for another product is refused. */
+const ISSUER = 'https://bridge.atheniq.institute';
+const AUDIENCE = 'atheniq-classroom';
+const CONTRACT_VERSION = 1;
+const CLOCK_TOLERANCE_SECONDS = 30;
+
+export interface AtheniqClaim {
+  sub: string;
+  role: 'learner' | 'instructor' | 'registrar' | 'service';
+  org: string;
+  courseKey: string;
+  classroomId: string;
+  name?: string;
+  email?: string;
+  lmsUsername?: string;
+  exp: number;
+}
+
+function decode(value: string): Uint8Array {
+  const normalized = value.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = normalized.padEnd(Math.ceil(normalized.length / 4) * 4, '=');
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
+  return bytes;
+}
+
+function readCookie(header: string | null, name: string): string | undefined {
+  if (!header) return undefined;
+  for (const part of header.split(';')) {
+    const separator = part.indexOf('=');
+    if (separator === -1) continue;
+    if (part.slice(0, separator).trim() !== name) continue;
+    return decodeURIComponent(part.slice(separator + 1).trim());
+  }
+  return undefined;
+}
+
+/** Verify the signature and every claim this app depends on. */
+export async function verifyAtheniqToken(
+  token: string,
+  secret: string,
+  now: number = Math.floor(Date.now() / 1000),
+): Promise<AtheniqClaim | null> {
+  const parts = token.split('.');
+  if (parts.length !== 3) return null;
+  const [header, body, signature] = parts as [string, string, string];
+
+  let head: unknown;
+  let payload: unknown;
+  try {
+    head = JSON.parse(new TextDecoder().decode(decode(header)));
+    payload = JSON.parse(new TextDecoder().decode(decode(body)));
+  } catch {
+    return null;
+  }
+  if (typeof head !== 'object' || head === null) return null;
+  if ((head as Record<string, unknown>).alg !== 'HS256') return null;
+
+  const key = await crypto.subtle.importKey(
+    'raw',
+    new TextEncoder().encode(secret),
+    { name: 'HMAC', hash: 'SHA-256' },
+    false,
+    ['verify'],
+  );
+  let valid = false;
+  try {
+    valid = await crypto.subtle.verify(
+      'HMAC',
+      key,
+      decode(signature),
+      new TextEncoder().encode(`${header}.${body}`),
+    );
+  } catch {
+    return null;
+  }
+  if (!valid) return null;
+
+  if (typeof payload !== 'object' || payload === null) return null;
+  const claims = payload as Record<string, unknown>;
+
+  if (claims.iss !== ISSUER || claims.aud !== AUDIENCE) return null;
+  if (claims.ver !== CONTRACT_VERSION) return null;
+  if (typeof claims.exp !== 'number' || claims.exp + CLOCK_TOLERANCE_SECONDS < now) return null;
+  if (typeof claims.sub !== 'string' || !claims.sub) return null;
+  if (typeof claims.courseKey !== 'string' || !claims.courseKey) return null;
+  if (typeof claims.classroomId !== 'string' || !claims.classroomId) return null;
+  if (typeof claims.org !== 'string' || !claims.org) return null;
+  const role = claims.role;
+  if (role !== 'learner' && role !== 'instructor' && role !== 'registrar' && role !== 'service') {
+    return null;
+  }
+
+  return {
+    sub: claims.sub,
+    role,
+    org: claims.org,
+    courseKey: claims.courseKey,
+    classroomId: claims.classroomId,
+    exp: claims.exp,
+    ...(typeof claims.name === 'string' ? { name: claims.name } : {}),
+    ...(typeof claims.email === 'string' ? { email: claims.email } : {}),
+    ...(typeof claims.lmsUsername === 'string' ? { lmsUsername: claims.lmsUsername } : {}),
+  };
+}
+
+/**
+ * The owner id this method mints.
+ *
+ * Prefixed so it can never collide with an anonymous uuid, a single-user id or
+ * a shared-team id in the same column — changing the scheme later would orphan
+ * every course already stored under it.
+ */
+export function ownerIdFor(claim: AtheniqClaim): string {
+  return `atheniq:${claim.sub}`;
+}
+
+/** Publishing is a staff act; a learner may own their library but not publish. */
+function rolesFor(claim: AtheniqClaim): ReadonlySet<string> {
+  const roles = new Set<string>();
+  if (claim.role === 'instructor' || claim.role === 'registrar' || claim.role === 'service') {
+    roles.add('course:publish');
+  }
+  if (claim.role === 'registrar' || claim.role === 'service') roles.add('admin');
+  return roles;
+}
+
+async function claimFromHeaders(headers: Headers): Promise<
+  { status: 'absent' } | { status: 'bad' } | { status: 'ok'; claim: AtheniqClaim }
+> {
+  const secret = process.env.ATHENIQ_BRIDGE_JWT_SECRET;
+  if (!secret) return { status: 'absent' };
+  const token = readCookie(headers.get('cookie'), ATHENIQ_COOKIE);
+  if (!token) return { status: 'absent' };
+  const claim = await verifyAtheniqToken(token, secret);
+  return claim ? { status: 'ok', claim } : { status: 'bad' };
+}
+
+/** The claim for a request, for routes that need the course it was minted for. */
+export async function atheniqClaimFromHeaders(headers: Headers): Promise<AtheniqClaim | null> {
+  const resolved = await claimFromHeaders(headers);
+  return resolved.status === 'ok' ? resolved.claim : null;
+}
+
+export const atheniqClassroomMethod: OwnerAuthMethod = {
+  name: 'atheniqClassroom',
+
+  async authenticate(req) {
+    const resolved = await claimFromHeaders(req.headers);
+    if (resolved.status === 'absent') return { status: 'not-applicable' };
+    if (resolved.status === 'bad') return { status: 'invalid', reason: 'atheniq token rejected' };
+
+    const principal: OwnerPrincipal = {
+      ownerId: ownerIdFor(resolved.claim),
+      kind: 'user',
+      roles: rolesFor(resolved.claim),
+      assurance: 'verified',
+      channel: 'atheniq-bridge',
+    };
+    return { status: 'authenticated', principal };
+  },
+
+  describeStoredOwner: (ownerId) =>
+    ownerId.startsWith('atheniq:') ? { kind: 'user', roles: new Set(['course:publish']) } : undefined,
+};
