@@ -0,0 +1,144 @@
+'use client';
+
+/**
+ * "Finish module" — the one AthenIQ control inside a classroom.
+ *
+ * It renders only when this classroom was launched through the AthenIQ bridge
+ * (the server says so at `/api/atheniq/classroom`, reading the signed HttpOnly
+ * cookie the browser cannot see). Pressing it reports the classroom to the
+ * bridge, which writes the completion and grade to the LMS, closes the
+ * enrollment in the console, and awards a certificate when the learner is
+ * eligible.
+ *
+ * The component deliberately renders no course data it could get wrong: the
+ * course and learner live in the signed token, server-side. If the bridge is
+ * unreachable the button says so and stays pressable — a completion retried
+ * later is the same completion, because the bridge deduplicates it.
+ */
+
+import { useEffect, useState } from 'react';
+
+interface Binding {
+  bridged: boolean;
+  courseKey?: string;
+  classroomId?: string;
+}
+
+type SendState = 'idle' | 'sending' | 'sent' | 'replay' | 'error';
+
+export function AtheniqCompletionReporter({ classroomId }: { classroomId: string }) {
+  const [binding, setBinding] = useState<Binding | null>(null);
+  const [state, setState] = useState<SendState>('idle');
+  const [detail, setDetail] = useState('');
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch('/api/atheniq/classroom', { headers: { accept: 'application/json' } })
+      .then((response) => (response.ok ? response.json() : { bridged: false }))
+      .then((value: Binding) => {
+        if (!cancelled) setBinding(value);
+      })
+      .catch(() => {
+        if (!cancelled) setBinding({ bridged: false });
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  if (!binding?.bridged) return null;
+
+  async function report() {
+    setState('sending');
+    setDetail('');
+    try {
+      const response = await fetch('/api/atheniq/completion', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        // The classroom id makes the submission idempotent: pressing twice, or a
+        // retry after a dropped response, cannot award twice.
+        body: JSON.stringify({ issueCredential: true, idempotencyKey: `classroom:${classroomId}` }),
+      });
+      const payload = (await response.json()) as {
+        replay?: boolean;
+        credential?: { verifyId?: string } | null;
+        steps?: { step: string; status: string }[];
+        error?: { message?: string };
+      };
+      if (!response.ok) {
+        setState('error');
+        setDetail(payload.error?.message ?? `The bridge answered ${response.status}.`);
+        return;
+      }
+      setState(payload.replay ? 'replay' : 'sent');
+      const award = payload.credential?.verifyId;
+      setDetail(
+        award
+          ? `Reported. Certificate ${award} issued.`
+          : payload.replay
+            ? 'This module was already reported.'
+            : 'Reported to the LMS and the console.',
+      );
+    } catch (error) {
+      setState('error');
+      setDetail(error instanceof Error ? error.message : 'Could not reach the bridge.');
+    }
+  }
+
+  const busy = state === 'sending';
+  const done = state === 'sent' || state === 'replay';
+
+  return (
+    <div
+      style={{
+        position: 'fixed',
+        right: 20,
+        bottom: 20,
+        zIndex: 60,
+        display: 'flex',
+        flexDirection: 'column',
+        alignItems: 'flex-end',
+        gap: 6,
+        maxWidth: 320,
+        fontFamily: 'ui-sans-serif, system-ui, sans-serif',
+      }}
+    >
+      {detail ? (
+        <p
+          role="status"
+          style={{
+            margin: 0,
+            padding: '8px 12px',
+            borderRadius: 10,
+            background: 'rgba(12, 18, 28, 0.92)',
+            color: state === 'error' ? '#ffb4a8' : '#d7f7e6',
+            fontSize: 12,
+            lineHeight: 1.4,
+            boxShadow: '0 6px 24px rgba(0,0,0,0.28)',
+          }}
+        >
+          {detail}
+        </p>
+      ) : null}
+      <button
+        type="button"
+        onClick={report}
+        disabled={busy}
+        title={binding.courseKey ? `Course ${binding.courseKey}` : undefined}
+        style={{
+          border: '1px solid rgba(255,255,255,0.16)',
+          borderRadius: 999,
+          padding: '10px 16px',
+          background: done ? 'rgba(16, 122, 87, 0.95)' : 'rgba(12, 18, 28, 0.92)',
+          color: '#f3f7fb',
+          fontSize: 13,
+          fontWeight: 600,
+          cursor: busy ? 'progress' : 'pointer',
+          boxShadow: '0 8px 28px rgba(0,0,0,0.32)',
+        }}
+      >
+        {busy ? 'Reporting…' : done ? 'Reported ✓' : 'Finish module'}
+      </button>
+    </div>
+  );
+}
