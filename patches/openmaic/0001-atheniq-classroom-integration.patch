@@ -0,0 +1,35 @@
+/**
+ * The classroom's own binding, for the UI.
+ *
+ * Answers with the course and classroom id the signed token carries, so the
+ * completion reporter can name them without the browser ever holding the token
+ * itself (it is HttpOnly).
+ */
+
+import { type NextRequest } from 'next/server';
+
+import { withRequestOwner } from '@/lib/server/identity/with-owner';
+import { atheniqClaimFromHeaders } from '@/lib/server/identity/host/atheniq-classroom';
+
+export const runtime = 'nodejs';
+
+export async function GET(req: NextRequest) {
+  return withRequestOwner(req, async (_principal, responseHeaders) => {
+    const claim = await atheniqClaimFromHeaders(req.headers);
+    const headers = new Headers(responseHeaders);
+    headers.set('cache-control', 'private, no-store');
+    if (!claim) {
+      return Response.json({ bridged: false }, { status: 200, headers });
+    }
+    return Response.json(
+      {
+        bridged: true,
+        courseKey: claim.courseKey,
+        classroomId: claim.classroomId,
+        learner: { name: claim.name ?? null, email: claim.email ?? null, role: claim.role },
+        expiresAt: new Date(claim.exp * 1000).toISOString(),
+      },
+      { status: 200, headers },
+    );
+  });
+}
diff --git a/app/api/atheniq/completion/route.ts b/app/api/atheniq/completion/route.ts
new file mode 100644
index 0000000..8ffab4b
--- /dev/null
+++ b/app/api/atheniq/completion/route.ts
@@ -0,0 +1,122 @@
+/**
+ * Report a finished classroom to the AthenIQ bridge.
+ *
+ * Identity and course come from the **signed token**, never from the request
+ * body: a learner cannot claim someone else's completion, or move a completion
+ * to another course, by editing JSON in the browser. The body carries only what
+ * the classroom observed — a score and the outcomes.
+ *
+ * The call to the bridge is signed with HMAC-SHA256 over `timestamp.body`, so
+ * the bridge accepts it without holding a long-lived service token here.
+ * When `ATHENIQ_BRIDGE_URL` is unset the route answers 503 with the reason
+ * instead of pretending a completion was recorded.
+ */
+
+import { createHmac } from 'node:crypto';
+import { type NextRequest } from 'next/server';
+
+import { withRequestOwner } from '@/lib/server/identity/with-owner';
+import { atheniqClaimFromHeaders } from '@/lib/server/identity/host/atheniq-classroom';
+
+export const runtime = 'nodejs';
+
+const MAX_BODY_BYTES = 64 * 1024;
+
+interface ReportBody {
+  score?: number;
+  maxScore?: number;
+  outcomes?: { id: string; label?: string; mastery?: number }[];
+  issueCredential?: boolean;
+  idempotencyKey?: string;
+}
+
+function boundedNumber(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined;
+}
+
+function outcomesOf(value: unknown): { id: string; label?: string; mastery?: number }[] {
+  if (!Array.isArray(value)) return [];
+  return value
+    .filter((item): item is Record<string, unknown> => typeof item === 'object' && item !== null)
+    .map((item) => ({
+      id: String(item.id ?? '').slice(0, 128),
+      ...(typeof item.label === 'string' ? { label: item.label.slice(0, 300) } : {}),
+      ...(boundedNumber(item.mastery) !== undefined ? { mastery: boundedNumber(item.mastery) } : {}),
+    }))
+    .filter((item) => /^[A-Za-z0-9._:-]{1,128}$/.test(item.id))
+    .slice(0, 100);
+}
+
+function jsonError(code: string, status: number, message: string) {
+  return Response.json({ ok: false, error: { code, message } }, { status });
+}
+
+export async function POST(req: NextRequest) {
+  return withRequestOwner(req, async (_principal, responseHeaders) => {
+    const bridgeUrl = (process.env.ATHENIQ_BRIDGE_URL ?? '').replace(/\/+$/, '');
+    const secret = process.env.ATHENIQ_BRIDGE_HOOK_SECRET ?? '';
+    if (!bridgeUrl || !secret) {
+      return jsonError(
+        'BRIDGE_NOT_CONFIGURED',
+        503,
+        'ATHENIQ_BRIDGE_URL and ATHENIQ_BRIDGE_HOOK_SECRET must be set to report a completion.',
+      );
+    }
+
+    const claim = await atheniqClaimFromHeaders(req.headers);
+    if (!claim) return jsonError('NOT_BRIDGED', 401, 'This request carries no AthenIQ classroom identity.');
+
+    const raw = await req.text();
+    if (raw.length > MAX_BODY_BYTES) return jsonError('BODY_TOO_LARGE', 413, 'Report body is too large.');
+    let body: ReportBody = {};
+    if (raw) {
+      try {
+        body = JSON.parse(raw) as ReportBody;
+      } catch {
+        return jsonError('BAD_JSON', 400, 'Report body is not valid JSON.');
+      }
+    }
+
+    // The bridge is authoritative for the learner and the course; the body only
+    // adds what the classroom measured.
+    const payload = JSON.stringify({
+      classroomId: claim.classroomId,
+      courseKey: claim.courseKey,
+      learnerId: claim.sub,
+      ...(claim.lmsUsername ? { lmsUsername: claim.lmsUsername } : {}),
+      ...(boundedNumber(body.score) !== undefined ? { score: body.score } : {}),
+      ...(boundedNumber(body.maxScore) !== undefined ? { maxScore: body.maxScore } : {}),
+      ...(outcomesOf(body.outcomes).length ? { outcomes: outcomesOf(body.outcomes) } : {}),
+      ...(body.issueCredential === true ? { issueCredential: true } : {}),
+      ...(typeof body.idempotencyKey === 'string' && body.idempotencyKey
+        ? { idempotencyKey: body.idempotencyKey.slice(0, 200) }
+        : {}),
+    });
+
+    const timestamp = String(Math.floor(Date.now() / 1000));
+    const signature = createHmac('sha256', secret).update(`${timestamp}.${payload}`).digest('hex');
+
+    let upstream: Response;
+    try {
+      upstream = await fetch(`${bridgeUrl}/v1/completions`, {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'x-atheniq-timestamp': timestamp,
+          'x-atheniq-signature': signature,
+        },
+        body: payload,
+        signal: AbortSignal.timeout(30_000),
+      });
+    } catch (error) {
+      const message = error instanceof Error ? error.message : String(error);
+      return jsonError('BRIDGE_UNREACHABLE', 502, `Could not reach the AthenIQ bridge: ${message}`);
+    }
+
+    const text = await upstream.text();
+    const headers = new Headers(responseHeaders);
+    headers.set('content-type', 'application/json');
+    headers.set('cache-control', 'private, no-store');
+    return new Response(text, { status: upstream.status, headers });
+  });
+}
