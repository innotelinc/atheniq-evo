# atheniq-evo — copy to .env and fill in. .env is gitignored; nothing here is a
# real secret.
#
# The three secrets below must be generated, not chosen. On a machine with
# openssl:
#   openssl rand -hex 32   # BRIDGE_JWT_SECRET
#   openssl rand -hex 24   # BRIDGE_SERVICE_TOKEN, BRIDGE_HOOK_SECRET
# The bridge refuses to start on a weak or missing key rather than minting
# classroom tokens anyone can forge.

# ------------------------------------------------------------------ brands --
ATHENIQ_ORG="AthenIQ Institute"
ATHENIQ_PUBLIC_HOST="atheniq.institute"

# ------------------------------------------------------------- institution --
# The public site and the student portal answer on INSTITUTION_ORIGIN; the
# registrar answers on REGISTRAR_ORIGIN. One process routes by Host header, so
# the edge must preserve Host and serve TLS for both names.
INSTITUTION_ORIGIN="https://atheniq.innotel.site"
REGISTRAR_ORIGIN="https://registrar.innotel.site"
INSTITUTION_PORT=8080
# 32+ characters. Signs student and staff session cookies; required in
# production. Generate it: openssl rand -hex 32
SESSION_SECRET=
# The registrar bootstrap account. Leave these empty to configure them through
# /setup on a fresh install, or fill them to configure the service from the
# environment. Prefer REGISTRAR_PASSWORD_HASH (a scrypt$ value).
REGISTRAR_EMAIL=""
REGISTRAR_PASSWORD=
# A scrypt$ hash contains $, so keep it in single quotes in .env.
REGISTRAR_PASSWORD_HASH=
# Addresses are issued as first.last@MAIL_DOMAIN. The domain must exist in
# Stalwart when MAIL_PROVIDER=stalwart.
MAIL_DOMAIN=""
# local = reserve in the registry only. stalwart = create the mailbox through
# Stalwart's JMAP management API on admission, password change and reset. If the
# mail server authenticates through an OIDC/LDAP directory, mailboxes are created
# without a password and students sign in to mail through that directory.
MAIL_PROVIDER=
# Stalwart API base URL. The API key needs Inherit permissions: Stalwart will
# not let a narrow key create a user, because it may not grant permissions it
# does not hold. See docs/institution.md. With MAIL_PROVIDER=stalwart the
# service queries MAIL_DOMAIN at startup and refuses to boot if this URL, the key
# or the domain is wrong.
STALWART_URL=""
STALWART_TOKEN=
# 0 = no per-mailbox disk quota. Otherwise, bytes.
STALWART_QUOTA_BYTES=0
# Demonstration applications/students for a local preview. Never in production.
INSTITUTION_SEED_DEMO=
# Compose defaults this to true because the service is published through an
# edge that sets X-Forwarded-Host and appends X-Forwarded-For. Set false when
# port 8080 is reachable directly; forwarded headers are then ignored.
# TRUST_PROXY=true
# Local preview over http must set this false; production requires true.
COOKIE_SECURE=true
# The console's public verification page, e.g. https://console.innotel.us/verify.
# The institution's /verify page links here and hides the button when empty.
CREDENTIAL_VERIFY_URL=
# The LMS whose public catalog the console syncs against. Read-only: the console
# asks /api/courses/v1/courses/ and reports which courses are live. Default in
# Compose is https://atheniq.courses.
LMS_PUBLIC_URL="https://atheniq.courses"
# The browser-reachable OpenMAIC origin, for the embedded classroom preview.
# Empty means the classroom page explains that embedding is not configured.
OPENMAIC_PUBLIC_URL=
# Read by the OpenMAIC image build, not at runtime: its CSP allows framing by
# 'self' plus these origins. Without it the registrar's iframe is refused even
# with a correct cookie. Space-separate several. Rebuild the image to change it.
OPENMAIC_FRAME_ANCESTORS="https://registrar.atheniq.institute"
# The classroom image Compose pulls: the one that workflow builds and proves,
# pinned by digest. A tag can be repointed; a digest cannot, so a deploy cannot
# silently swap the classroom for a build nobody proved. Bump it from the digest
# the `openmaic image` workflow prints in its run summary, then re-run the CSP
# check below. The CSP baked into the image is the value above; a different one
# means the image has to be built here, under a local tag:
#   OPENMAIC_IMAGE=openmaic:local OPENMAIC_FRAME_ANCESTORS=https://example.org \
#     docker compose build openmaic
#   OPENMAIC_IMAGE=openmaic:local docker compose up -d --pull never openmaic
#
# Whatever is running, this is the proof that the iframe will not be blank.
# `npm run up` runs it after `docker compose up -d --wait` and fails the start
# when the running image disagrees, so bring the estate up with that:
#   npm run up
#   npm run check:openmaic-csp     # on its own
OPENMAIC_IMAGE="docker.io/innotel/atheniq-evo-openmaic@sha256:fd0e3757eb7c8670b37c6122ba23ed1135ae8602c2de124df47daedf1a4a0a92"

# ------------------------------------------------------------------ bridge --
BRIDGE_ORIGIN="http://localhost:8787"
PORT=8787
BRIDGE_JWT_SECRET=
BRIDGE_SERVICE_TOKEN=
BRIDGE_HOOK_SECRET=
BRIDGE_DATA_DIR="data"
BRIDGE_TOKEN_TTL_SECONDS=900
# Automatic retry of partial completions: sweep cadence, first delay, cap, and
# how long a record may stay partial before it alerts and fails health.
BRIDGE_RETRY_ENABLED=true
BRIDGE_RETRY_INTERVAL_MS=60000
BRIDGE_RETRY_BASE_MS=60000
BRIDGE_RETRY_MAX_MS=3600000
BRIDGE_RETRY_ALERT_AFTER_MS=1800000
# Set to the shared parent domain when the console, the classroom and the
# bridge are on different hosts (e.g. ".atheniq.institute"), so the launch
# cookie is readable by the classroom and by nothing else.
CLASSROOM_COOKIE_DOMAIN=

# ------------------------------------------------------------------- OpenMAIC --
OPENMAIC_BASE_URL="http://localhost:3000"
# Read by the OpenMAIC patch: verifies the classroom token the console sets.
ATHENIQ_BRIDGE_JWT_SECRET=
# Read by the OpenMAIC patch: where a completion callback goes, and how it is signed.
ATHENIQ_BRIDGE_URL="http://localhost:8787"
ATHENIQ_BRIDGE_HOOK_SECRET=

# OpenMAIC's own persistence. Required by OpenMAIC; it refuses to boot without it.
DATABASE_URL="postgres://openmaic:openmaic-dev@127.0.0.1:5432/openmaic"

# ---------------------------------------------------------------- Open edX --
# The LMS base URL as a learner sees it; the bridge calls its REST API.
LMS_BASE_URL="http://localhost:18000"
# A staff/service OAuth2 access token with course-author rights. See
# deploy/openedx/provision-bridge.sh — it creates the user and prints the token.
LMS_API_TOKEN=
# The graded block an AI classroom's score is written to (a sequential in the
# course). Leave empty to write completions only, with no grade override.
LMS_GRADE_USAGE_ID=
# Open edX does not expose numeric user ids over REST, and the gradebook write
# API needs one. Map AthenIQ learner ids to them here (JSON: {"lrn_…": 42}).
LMS_USER_MAP_PATH=
LMS_USERNAME_MAP_PATH=

# ------------------------------------------------------------ console -------
# Browser-visible console URL. Empty hides the portal/registrar console link;
# never use the Compose service name here.
CONSOLE_BASE_URL="http://localhost:3100"
# Where the Next.js console sends course authoring: the institution console.
# Its /courses and /generate pages redirect here and its sidebar links here, so
# no second place can add, edit, generate or remove a course. Next inlines this
# at build time, so it reaches the console image as `build.args`: rebuild after
# changing it. Pointing it at the console's own host creates a redirect loop.
INSTITUTION_CONSOLE_URL="https://registrar.atheniq.institute"
# Shared with the bridge's BRIDGE_SERVICE_TOKEN: the console accepts the bridge's
# service calls at /api/internal/atheniq with this value.
CONSOLE_SERVICE_TOKEN=
# Read by the console patch: offers the "AI classroom" button and launches it.
ATHENIQ_BRIDGE_URL="http://localhost:8787"
ATHENIQ_BRIDGE_SERVICE_TOKEN=
ATHENIQ_CLASSROOM_COOKIE_DOMAIN=

# --------------------------------------------------------------- Signara -----
# The console holds this key; the bridge never talks to Signara directly, so
# awarding stays in one place.
# The API host without a path. The key is created in Signara and sent as
# X-API-Key: sgn_... . Without a key awards stay queued_local.
SIGNARA_API_URL="https://api.signara.innotel.us"
SIGNARA_API_KEY=
CERT_SIGNER_NAME="D. Hunter"
CERT_SIGNER_TITLE="Founder - Innotel"
CERT_SIGNER_EMAIL="dhunter@innotel.us"

# -------------------------------------------------------------- OmniRoute ----
# One gateway for every model call in the estate: the console's course studio
# and OpenMAIC's outline, slides, images, speech and video. The key lives here
# and in .env only — never in client code, never in a repository.
OMNIROUTE_BASE_URL="https://gateway.innotel.us/v1"
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-chat

# ----------------------------------------------------------------- postgres --
POSTGRES_PASSWORD="change-me-too"
