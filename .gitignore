# Secrets — never commit
.env
.env.*
!.env.example
!*.example
*.pem
*.p8
*.key

# Runtime state
data/
# Written by /setup; holds the session secret and mail API key
setup.json
*.ledger.json
*.log
logs/

# Fetched upstreams — pinned in upstream.lock.json, never vendored
upstream/

# Machine-local development scaffolding (e.g. a portable Postgres)
.local/

# Node
node_modules/
.next/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Python / Open edX
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
